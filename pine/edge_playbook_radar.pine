// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
//
// EDGE — Playbook setup radar (Daily · 4H · 15m · 5m)
// ---------------------------------------------------------------------------
// Put it on a 5-minute chart of MNQ, MES, MGC, SIL, MCL, MYM, MHG or MNG
// (micro futures — it works the same on the full-size contracts).
//
// It does NOT trade. It watches the chart for your playbook and tells the Edge app
// the moment a setup is ready, with the exact limit, stop and target.
//
//   1. Big picture : Daily and 4H trend from break of structure — the trend turns UP
//                    when a candle CLOSES above the last swing high, DOWN when it closes
//                    below the last swing low. The base (1–3 small candles) right before
//                    the explosive candle that broke structure and left a fair value gap
//                    becomes a Daily / 4H demand or supply zone (wick → body).
//                    A zone dies when a candle of its timeframe closes through it.
//   2. Direction   : trade WITH the Daily trend (4H if the Daily has none yet).
//                    Against it ONLY from inside (or right next to) a 4H / Daily zone
//                    that opposes the trend.
//   3. 15m zone    : the base before the most explosive 15m candle of a 15m break of
//                    structure. Fresh = touched at most once before. Zones built inside
//                    a tight range (consolidation) are skipped.
//   4. 5m trigger  : price trades into the fresh 15m zone, then a 5m candle CLOSES
//                    beyond the last 5m swing (change of character). The move leaves a
//                    5m fair value gap → LIMIT at the START of that gap (its near edge).
//   5. Stop        : beyond the low (longs) / high (shorts) of the move, 2 ticks past it.
//   6. Target      : the next 15m swing high (longs) / low (shorts) not taken yet.
//                    At least 3R, at most 10R (a farther target is pulled in to 10R).
//   7. Liquidity   : "liq" = price swept a 5m/15m swing during the visit, then closed back.
//   8. Session     : setups are only armed 02:00–11:30 New York time.
//   9. One alert per setup. An unfilled limit is forgotten (no alert) if price closes
//                    past the stop or runs to the target first.
//
// For the Edge app, create ONE alert on this chart:
//   Condition: this script → "Any alert() function call"
//   Webhook URL: https://<your-edge-app>/api/hook
//   Message: leave as is (the script writes its own JSON)
// ---------------------------------------------------------------------------
//@version=6
indicator("Edge — Playbook setup radar (D · 4H · 15m · 5m)", shorttitle = "Edge radar", overlay = true,
     max_boxes_count = 200, max_lines_count = 300, max_labels_count = 300, max_bars_back = 200)

TZ = "America/New_York"

// ---------- Settings
grpP = "Playbook"
minR       = input.float(3.0, "Smallest reward:risk to send a setup (R)", minval = 1.0, step = 0.5, group = grpP)
maxR       = input.float(10.0, "Largest target (R) — farther liquidity is pulled in to this", minval = 2.0, step = 0.5, group = grpP)
sess       = input.session("0200-1130", "Arm setups only between (New York time)", group = grpP)
freshOnly  = input.bool(true, "Only trade fresh 15m zones", group = grpP)
maxPrior   = input.int(1, "Fresh = touched at most this many times before", minval = 0, maxval = 5, group = grpP)
nearFrac   = input.float(0.25, "Counter-trend: price within (× 4H/Daily zone height) of the zone", minval = 0.0, step = 0.05, group = grpP)
noLiqMax   = input.bool(false, "No untaken 15m swing beyond the entry → use the max-R target anyway", group = grpP)
maxWait    = input.int(48, "Give up on a 15m zone visit after (5m candles, 48 = 4 hours)", minval = 6, group = grpP)
fvgWait    = input.int(3, "After the change of character, wait this many 5m candles for the gap", minval = 1, maxval = 10, group = grpP)
pendMax    = input.int(36, "Forget an unfilled limit after (5m candles, 36 = 3 hours)", minval = 3, group = grpP)

grpZ = "Zones & swings"
htfLen     = input.int(3, "Daily / 4H swing size (candles each side)", minval = 1, maxval = 10, group = grpZ)
mtfLen     = input.int(2, "15m swing size (candles each side)", minval = 1, maxval = 10, group = grpZ)
ltfLen     = input.int(2, "5m swing size (candles each side)", minval = 1, maxval = 10, group = grpZ)
baseRatio  = input.float(0.5, "Base candle = body at most (× the explosive candle's body)", minval = 0.1, maxval = 1.0, step = 0.05, group = grpZ)
maxLeg     = input.int(12, "Look back for the explosive candle (candles of that timeframe)", minval = 2, maxval = 40, group = grpZ)
consLen    = input.int(20, "15m consolidation check: candles before the base", minval = 5, maxval = 50, group = grpZ)
consMult   = input.float(2.0, "…skip the zone if their range is under (× 15m ATR)", minval = 0.0, step = 0.25, group = grpZ)
zonesMax   = input.int(5, "Zones kept each side, per timeframe", minval = 1, maxval = 10, group = grpZ)

grpD = "Drawings"
showDraw   = input.bool(true, "Show zones, setups and levels", group = grpD)
showSkips  = input.bool(false, "Show skipped triggers (with the reason)", group = grpD)
cD   = input.color(#ff8c42, "Daily zones", group = grpD)
c4h  = input.color(#9b5de5, "4H zones", group = grpD)
c15  = input.color(#2f80ed, "15m zones", group = grpD)
c5   = input.color(#f2c94c, "5m entry (fair value gap)", group = grpD)

grpA = "Edge app alerts"
secret     = input.string("change-me", "Webhook secret (same as EDGE_HOOK_SECRET)", group = grpA)
sendBars   = input.bool(true, "Send a price heartbeat every closed 5m candle", group = grpA)

// ---------- Structure + supply & demand zones (runs on the Daily, 4H and 15m candles)
// Everything is shifted back by `off` candles: with off = 1 we only ever use CLOSED
// higher-timeframe candles, so nothing on this chart repaints.
// Returns: trend (1 up / -1 down / 0 none yet), the newest demand and supply zone
// (top, bottom, when it was found, when its base started), the last confirmed swing
// high / low (level + time), and the candle's close and open time.
sdStructure(int len, float ratio, int legMax, bool useCons, int cLen, float cMult, int off) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    float atr = ta.atr(14)
    float hiN = ta.highest(high, cLen)
    float loN = ta.lowest(low, cLen)
    var float swingHigh = na      // last swing high not broken yet (the break-of-structure level)
    var float swingLow = na
    var float lastPH = na         // last confirmed swing high (kept after it breaks)
    var float lastPL = na
    var int lastPHT = 0
    var int lastPLT = 0
    var int phBar = 0
    var int plBar = 0
    var int trend = 0
    var int upBar = -10           // candle that broke structure up / down
    var int dnBar = -10
    var int upFrom = 0            // where that leg started (the swing it came from)
    var int dnFrom = 0
    var float demTop = na
    var float demBot = na
    var int demT = 0
    var int demFrom = 0
    var float supTop = na
    var float supBot = na
    var int supT = 0
    var int supFrom = 0
    if not na(ph)
        swingHigh := ph
        lastPH := ph
        lastPHT := time[len]
        phBar := bar_index - len
    if not na(pl)
        swingLow := pl
        lastPL := pl
        lastPLT := time[len]
        plBar := bar_index - len
    // One candle after a break UP (so the gap of the breaking candle is complete):
    // find the most explosive up candle of the leg that left a fair value gap,
    // then its base = the 1–3 small candles right before it.
    if upBar == bar_index - 1
        int legLen = math.min(legMax, bar_index - upFrom)
        int best = -1
        float bestBody = 0.0
        if legLen >= 1
            for i = 1 to legLen
                float bd = close[i] - open[i]
                if bd > bestBody and low[i - 1] > high[i + 1]
                    best := i
                    bestBody := bd
        if best > 0
            int nBase = 0
            for j = 1 to 3
                if nBase == j - 1 and math.abs(close[best + j] - open[best + j]) <= ratio * bestBody
                    nBase := nBase + 1
            nBase := math.max(nBase, 1)
            float zb = low[best + 1]
            float zt = math.max(open[best + 1], close[best + 1])
            for j = 1 to nBase
                zb := math.min(zb, low[best + j])
                zt := math.max(zt, math.max(open[best + j], close[best + j]))
            int ob = best + nBase
            bool consol = useCons and (hiN[ob + 1] - loN[ob + 1]) < cMult * atr[ob + 1]
            if not consol and zt > zb
                demTop := zt
                demBot := zb
                demT := time
                demFrom := time[ob]
    // Mirror image after a break DOWN: supply zone = base's high (wick) → lowest body.
    if dnBar == bar_index - 1
        int legLen = math.min(legMax, bar_index - dnFrom)
        int best = -1
        float bestBody = 0.0
        if legLen >= 1
            for i = 1 to legLen
                float bd = open[i] - close[i]
                if bd > bestBody and high[i - 1] < low[i + 1]
                    best := i
                    bestBody := bd
        if best > 0
            int nBase = 0
            for j = 1 to 3
                if nBase == j - 1 and math.abs(close[best + j] - open[best + j]) <= ratio * bestBody
                    nBase := nBase + 1
            nBase := math.max(nBase, 1)
            float zt = high[best + 1]
            float zb = math.min(open[best + 1], close[best + 1])
            for j = 1 to nBase
                zt := math.max(zt, high[best + j])
                zb := math.min(zb, math.min(open[best + j], close[best + j]))
            int ob = best + nBase
            bool consol = useCons and (hiN[ob + 1] - loN[ob + 1]) < cMult * atr[ob + 1]
            if not consol and zt > zb
                supTop := zt
                supBot := zb
                supT := time
                supFrom := time[ob]
    // Break of structure = a CLOSE beyond the last swing
    if not na(swingHigh) and close > swingHigh
        trend := 1
        swingHigh := na
        upBar := bar_index
        upFrom := plBar
    if not na(swingLow) and close < swingLow
        trend := -1
        swingLow := na
        dnBar := bar_index
        dnFrom := phBar
    [trend[off], demTop[off], demBot[off], demT[off], demFrom[off], supTop[off], supBot[off], supT[off], supFrom[off],
     lastPH[off], lastPHT[off], lastPL[off], lastPLT[off], close[off], time[off]]

[dTrend, dDemTop, dDemBot, dDemT, dDemFrom, dSupTop, dSupBot, dSupT, dSupFrom, dPH, dPHT, dPL, dPLT, dClose, dTime] = request.security(syminfo.tickerid, "D", sdStructure(htfLen, baseRatio, maxLeg, false, consLen, consMult, 1), lookahead = barmerge.lookahead_on)
[hTrend, hDemTop, hDemBot, hDemT, hDemFrom, hSupTop, hSupBot, hSupT, hSupFrom, hPH, hPHT, hPL, hPLT, hClose, hTime] = request.security(syminfo.tickerid, "240", sdStructure(htfLen, baseRatio, maxLeg, false, consLen, consMult, 1), lookahead = barmerge.lookahead_on)
[mTrend, mDemTop, mDemBot, mDemT, mDemFrom, mSupTop, mSupBot, mSupT, mSupFrom, mPH, mPHT, mPL, mPLT, mClose, mTime] = request.security(syminfo.tickerid, "15", sdStructure(mtfLen, baseRatio, maxLeg, true, consLen, consMult, 1), lookahead = barmerge.lookahead_on)
float atrD = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)

int trendD = nz(dTrend)
int trend4h = nz(hTrend)
// The side you trade: the Daily trend, or the 4H when the Daily has none yet
int bias = trendD != 0 ? trendD : trend4h
bool inSess = not na(time(timeframe.period, sess, TZ))
string sessName = hour(time, TZ) < 8 ? "london" : "ny"

// ---------- 5m swings (the change of character levels)
float ph5 = ta.pivothigh(high, ltfLen, ltfLen)
float pl5 = ta.pivotlow(low, ltfLen, ltfLen)
var float swHi5 = na     // last 5m swing high not broken yet
var float swLo5 = na
var float lastHi5 = na   // last 5m swing high (kept after it breaks)
var float lastLo5 = na
if not na(ph5)
    swHi5 := ph5
    lastHi5 := ph5
if not na(pl5)
    swLo5 := pl5
    lastLo5 := pl5

// ---------- Zones, tracked on this chart
type Zone
    float top
    float bot
    bool isDem
    string tf
    int touches = 0
    bool wasIn = false
    bool away = true
    bool alive = true
    box bx

var array<Zone> dDems = array.new<Zone>()
var array<Zone> dSups = array.new<Zone>()
var array<Zone> hDems = array.new<Zone>()
var array<Zone> hSups = array.new<Zone>()
var array<Zone> mDems = array.new<Zone>()
var array<Zone> mSups = array.new<Zone>()
// 15m swing highs / lows that price has not traded through yet = the targets (liquidity)
var array<float> highs15 = array.new<float>()
var array<float> lows15 = array.new<float>()

fm(float x) => str.tostring(x, format.mintick)
f(float x) => na(x) ? "null" : str.tostring(x, format.mintick)
b(bool x) => x ? "true" : "false"

addZone(array<Zone> list, float top, float bot, bool isDem, string tf, color c, int fromT) =>
    box bx = na
    if showDraw
        bx := box.new(fromT, top, time, bot, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(c, 30),
             bgcolor = color.new(c, isDem ? 85 : 90), text = tf + (isDem ? " demand" : " supply"), text_color = c,
             text_size = size.tiny, text_halign = text.align_right, force_overlay = true)
    list.push(Zone.new(top = top, bot = bot, isDem = isDem, tf = tf, bx = bx))
    if list.size() > zonesMax
        Zone old = list.shift()
        old.alive := false
        if not na(old.bx)
            box.delete(old.bx)
    list.size()

// a zone dies when a CLOSED candle of its own timeframe closes through its far side
killZones(array<Zone> list, float cls) =>
    int n = list.size()
    if n > 0 and not na(cls)
        for k = n - 1 to 0
            Zone z = list.get(k)
            if z.isDem ? cls < z.bot : cls > z.top
                z.alive := false
                if not na(z.bx)
                    box.set_bgcolor(z.bx, color.new(color.gray, 92))
                    box.set_border_color(z.bx, color.new(color.gray, 70))
                    box.set_extend(z.bx, extend.none)
                    box.set_right(z.bx, time)
                list.remove(k)
    list.size()

// returns the zone price ENTERED on this candle (newest first) and counts visits.
// A new visit only counts after price has really left the zone (one zone height away).
visitZones(array<Zone> list) =>
    Zone hit = na
    int n = list.size()
    if n > 0
        for k = n - 1 to 0
            Zone z = list.get(k)
            float h = z.top - z.bot
            if z.isDem ? low > z.top + h : high < z.bot - h
                z.away := true
            bool inZ = low <= z.top and high >= z.bot
            if inZ and not z.wasIn and z.away
                z.touches := z.touches + 1
                z.away := false
                if not na(z.bx)
                    box.set_text(z.bx, z.tf + (z.isDem ? " demand · visit " : " supply · visit ") + str.tostring(z.touches))
                if na(hit)
                    hit := z
            z.wasIn := inZ
    hit

// is price inside, or within nearFrac × height of, one of these (4H / Daily) zones?
nearHtfZone(array<Zone> list) =>
    bool r = false
    for z in list
        float pad = nearFrac * (z.top - z.bot)
        if low <= z.top + pad and high >= z.bot - pad
            r := true
    r

// remove the 15m swings price has traded through (that liquidity is taken)
dropTaken(array<float> list, bool isHigh) =>
    int n = list.size()
    if n > 0
        for k = n - 1 to 0
            float v = list.get(k)
            if isHigh ? high > v : low < v
                list.remove(k)
    list.size()

// the most recent untaken 15m swing beyond the entry (above for longs, below for shorts)
liqTarget(bool isL, float entry) =>
    float t = na
    array<float> list = isL ? highs15 : lows15
    int n = list.size()
    if n > 0
        for k = n - 1 to 0
            float v = list.get(k)
            if na(t) and (isL ? v > entry : v < entry)
                t := v
    t

// nearest live 4H / Daily zone within 1 × daily ATR of price, as text for the heartbeat
nearestZone(array<Zone> list, float bestD, string bestTxt) =>
    float d0 = bestD
    string t0 = bestTxt
    for z in list
        float dist = close > z.top ? close - z.top : close < z.bot ? z.bot - close : 0.0
        if not na(atrD) and dist <= atrD and (na(d0) or dist < d0)
            d0 := dist
            t0 := z.tf + (z.isDem ? " demand " : " supply ") + fm(z.bot) + "–" + fm(z.top)
    [d0, t0]

// ---------- The setup hunters (one for longs, one for shorts)
// state 0 = waiting for price to enter a 15m zone
//       1 = in the zone, waiting for the 5m change of character
//       2 = change of character done, looking for the 5m fair value gap
//       3 = limit order sent, waiting (filled / cancelled → back to 0, no alert)
type Hunt
    int dir
    int state = 0
    Zone zone
    int touchBar = 0
    float ext = na
    int extBar = 0
    bool fresh = false
    bool fromHtf = false
    float lvl5 = na
    bool hit5 = false
    float lvl15 = na
    bool hit15 = false
    bool swept = false
    int chochBar = 0
    float entry = na
    float sl = na
    float tp = na
    float rr = na
    int fvgBar = 0
    int armBar = 0
    line le
    line ls
    line lt

var Hunt huntL = Hunt.new(dir = 1)
var Hunt huntS = Hunt.new(dir = -1)

setupJson(Hunt h) =>
    '{"secret":"' + secret + '","type":"setup","strategy":"playbook","symbol":"' + syminfo.ticker + '","tv":"' + syminfo.tickerid +
     '","dir":"' + (h.dir == 1 ? "long" : "short") + '","entry":' + f(h.entry) + ',"sl":' + f(h.sl) + ',"tp":' + f(h.tp) +
     ',"rr":' + str.tostring(h.rr, "0.00") + ',"tf":"5m","zoneTop":' + f(h.zone.top) + ',"zoneBot":' + f(h.zone.bot) +
     ',"trendD":' + str.tostring(trendD) + ',"trend4h":' + str.tostring(trend4h) + ',"withTrend":' + b(bias == h.dir) +
     ',"fromHtfZone":' + b(h.fromHtf) + ',"fresh":' + b(h.fresh) + ',"liq":' + b(h.swept) + ',"session":"' + sessName + '"}'

drawPlan(Hunt h) =>
    bool isL = h.dir == 1
    int x2 = bar_index + 20
    box.new(h.touchBar, h.zone.top, x2, h.zone.bot, border_color = color.new(c15, 0), bgcolor = color.new(c15, 78),
         text = "15m zone", text_color = c15, text_size = size.tiny, text_halign = text.align_left, force_overlay = true)
    h.le := line.new(h.fvgBar, h.entry, x2, h.entry, color = c5, width = 2, force_overlay = true)
    h.ls := line.new(h.fvgBar, h.sl, x2, h.sl, color = color.red, width = 2, force_overlay = true)
    h.lt := line.new(h.fvgBar, h.tp, x2, h.tp, color = color.green, width = 2, force_overlay = true)
    label.new(x2, h.entry, "limit " + fm(h.entry), style = label.style_label_left, color = color.new(c5, 40), textcolor = color.white, size = size.tiny, force_overlay = true)
    label.new(x2, h.sl, "SL " + fm(h.sl), style = label.style_label_left, color = color.new(color.red, 50), textcolor = color.white, size = size.tiny, force_overlay = true)
    label.new(x2, h.tp, "TP " + fm(h.tp), style = label.style_label_left, color = color.new(color.green, 50), textcolor = color.white, size = size.tiny, force_overlay = true)
    label.new(bar_index, isL ? low : high, (h.swept ? "A+" : "A") + " setup " + str.tostring(h.rr, "0.0") + "R",
         style = isL ? label.style_label_up : label.style_label_down, color = isL ? color.new(color.green, 0) : color.new(color.red, 0),
         textcolor = color.white, size = size.small, force_overlay = true)

endPlan(Hunt h, string txt) =>
    if showDraw and not na(h.le)
        line.set_x2(h.le, bar_index)
        line.set_x2(h.ls, bar_index)
        line.set_x2(h.lt, bar_index)
        label.new(bar_index, h.entry, txt, style = label.style_label_left, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny, force_overlay = true)
    h.le := na
    h.ls := na
    h.lt := na
    h.state

skip(Hunt h, string why) =>
    if showDraw and showSkips
        label.new(bar_index, h.dir == 1 ? low : high, "skip: " + why, style = h.dir == 1 ? label.style_label_up : label.style_label_down,
             color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny, force_overlay = true)
    h.state := 0
    h.state

// After the change of character: find the fair value gap of the move, price the trade, send it.
tryArm(Hunt h) =>
    bool isL = h.dir == 1
    int legLen = math.min(bar_index - h.extBar, 30)
    int best = -1
    float runEx = na   // lowest low (longs) / highest high (shorts) of the candles AFTER the gap
    if legLen >= 2
        for k = 0 to legLen - 2
            bool gap = isL ? low[k] > high[k + 2] : high[k] < low[k + 2]
            // keep the EARLIEST gap of the move that price has not traded back into yet
            if gap and (na(runEx) or (isL ? runEx > low[k] : runEx < high[k]))
                best := k
            runEx := na(runEx) ? (isL ? low[k] : high[k]) : isL ? math.min(runEx, low[k]) : math.max(runEx, high[k])
    if best >= 0
        float entry = isL ? low[best] : high[best]          // the START (near edge) of the gap
        float sl = isL ? h.ext - 2 * syminfo.mintick : h.ext + 2 * syminfo.mintick
        float risk = math.abs(entry - sl)
        float tp = liqTarget(isL, entry)
        float rr = na
        if risk > 0
            if not na(tp)
                rr := math.abs(tp - entry) / risk
            else if noLiqMax
                tp := entry + h.dir * maxR * risk
                rr := maxR
            if not na(rr) and rr > maxR
                tp := entry + h.dir * maxR * risk
                rr := maxR
        bool dirOk = bias == h.dir or h.fromHtf
        bool sideOk = isL ? entry < close : entry > close
        if risk <= 0 or not sideOk
            skip(h, "no clean gap")
        else if na(tp)
            skip(h, "no 15m liquidity to target")
        else if rr < minR
            skip(h, str.tostring(rr, "0.0") + "R < " + str.tostring(minR) + "R")
        else if not dirOk
            skip(h, "against the trend, not at a 4H/Daily zone")
        else if not inSess
            skip(h, "outside the session")
        else
            h.entry := entry
            h.sl := sl
            h.tp := tp
            h.rr := rr
            h.fvgBar := bar_index - best
            h.armBar := bar_index
            h.state := 3
            alert(setupJson(h), alert.freq_once_per_bar_close)
            if showDraw
                drawPlan(h)
    else if bar_index - h.chochBar >= fvgWait
        h.state := 1   // no gap came: keep waiting in the zone for the next change of character
    h.state

// One closed 5m candle for one hunter.
//   hit     : the 15m zone (of this side) price entered on this candle, if any
//   cho     : 5m change of character in this side's direction on this candle
//   piv5    : a 5m swing low (longs) / high (shorts) confirmed on this candle
//   new15   : a 15m swing low / high confirmed on this candle, at level piv15
//   nearHtf : price is inside / next to a 4H or Daily zone of this side
runHunt(Hunt h, Zone hit, bool cho, float piv5, bool new15, float piv15, bool nearHtf) =>
    bool isL = h.dir == 1
    // 1) a limit is waiting: filled, or cancelled? (no alert either way — Edge takes it from here)
    if h.state == 3
        bool filled = isL ? low <= h.entry : high >= h.entry
        bool pastStop = isL ? close < h.sl : close > h.sl
        bool atTarget = isL ? high >= h.tp : low <= h.tp
        bool tooOld = bar_index - h.armBar > pendMax
        if filled or pastStop or atTarget or tooOld
            endPlan(h, filled ? "limit filled" : pastStop ? "cancelled: closed past the stop" : atTarget ? "cancelled: ran to target" : "cancelled: not filled in time")
            h.state := 0
    // 2) price just entered a 15m zone of this side, and this side is allowed
    else if h.state == 0 and not na(hit) and (bias == h.dir or nearHtf)
        bool fr = hit.touches - 1 <= maxPrior
        if fr or not freshOnly
            h.state := 1
            h.zone := hit
            h.touchBar := bar_index
            h.ext := isL ? low : high
            h.extBar := bar_index
            h.fresh := fr
            h.fromHtf := nearHtf
            h.swept := false
            float l5 = isL ? lastLo5 : lastHi5
            float l15 = isL ? mPL : mPH
            // only swings price has not already closed beyond can be swept
            h.lvl5 := not na(l5) and (isL ? close >= l5 : close <= l5) ? l5 : na
            h.hit5 := false
            h.lvl15 := not na(l15) and (isL ? close >= l15 : close <= l15) ? l15 : na
            h.hit15 := false
    // 3) during the visit
    if h.state == 1 or h.state == 2
        // the extreme of the move since the touch (it becomes the stop)
        if isL ? low < h.ext : high > h.ext
            h.ext := isL ? low : high
            h.extBar := bar_index
            if h.state == 2 and bar_index > h.chochBar
                h.state := 1   // a new low (high) after the change of character: the move failed
        // liquidity sweep before the change of character
        if h.state == 1
            if not na(piv5)
                h.lvl5 := piv5
                h.hit5 := false
            if new15 and not na(piv15)
                h.lvl15 := piv15
                h.hit15 := false
            if not na(h.lvl5)
                if isL ? low < h.lvl5 : high > h.lvl5
                    h.hit5 := true
                if h.hit5 and (isL ? close > h.lvl5 : close < h.lvl5)
                    h.swept := true
            if not na(h.lvl15)
                if isL ? low < h.lvl15 : high > h.lvl15
                    h.hit15 := true
                if h.hit15 and (isL ? close > h.lvl15 : close < h.lvl15)
                    h.swept := true
        if not h.zone.alive or bar_index - h.touchBar > maxWait
            h.state := 0
        else
            if h.state == 1 and cho
                h.state := 2
                h.chochBar := bar_index
            if h.state == 2
                tryArm(h)
    h.state

// ---------- Every CLOSED 5m candle
var int seenDBar = 0
var int seenHBar = 0
var int seenMBar = 0
var int seenDDem = 0
var int seenDSup = 0
var int seenHDem = 0
var int seenHSup = 0
var int seenMDem = 0
var int seenMSup = 0
var int seenMPH = 0
var int seenMPL = 0

if barstate.isconfirmed
    // zones die when a closed candle of their timeframe closes through them
    if nz(dTime) > 0 and dTime != seenDBar
        seenDBar := dTime
        killZones(dDems, dClose)
        killZones(dSups, dClose)
    if nz(hTime) > 0 and hTime != seenHBar
        seenHBar := hTime
        killZones(hDems, hClose)
        killZones(hSups, hClose)
    if nz(mTime) > 0 and mTime != seenMBar
        seenMBar := mTime
        killZones(mDems, mClose)
        killZones(mSups, mClose)

    // new zones
    if nz(dDemT) > 0 and dDemT != seenDDem and not na(dDemTop)
        seenDDem := dDemT
        addZone(dDems, dDemTop, dDemBot, true, "Daily", cD, dDemFrom)
    if nz(dSupT) > 0 and dSupT != seenDSup and not na(dSupTop)
        seenDSup := dSupT
        addZone(dSups, dSupTop, dSupBot, false, "Daily", cD, dSupFrom)
    if nz(hDemT) > 0 and hDemT != seenHDem and not na(hDemTop)
        seenHDem := hDemT
        addZone(hDems, hDemTop, hDemBot, true, "4H", c4h, hDemFrom)
    if nz(hSupT) > 0 and hSupT != seenHSup and not na(hSupTop)
        seenHSup := hSupT
        addZone(hSups, hSupTop, hSupBot, false, "4H", c4h, hSupFrom)
    if nz(mDemT) > 0 and mDemT != seenMDem and not na(mDemTop)
        seenMDem := mDemT
        addZone(mDems, mDemTop, mDemBot, true, "15m", c15, mDemFrom)
    if nz(mSupT) > 0 and mSupT != seenMSup and not na(mSupTop)
        seenMSup := mSupT
        addZone(mSups, mSupTop, mSupBot, false, "15m", c15, mSupFrom)

    // 15m swings = liquidity (targets), removed once price trades through them
    bool new15Hi = nz(mPHT) > 0 and mPHT != seenMPH and not na(mPH)
    bool new15Lo = nz(mPLT) > 0 and mPLT != seenMPL and not na(mPL)
    if new15Hi
        seenMPH := mPHT
        highs15.push(mPH)
        if highs15.size() > 30
            highs15.shift()
    if new15Lo
        seenMPL := mPLT
        lows15.push(mPL)
        if lows15.size() > 30
            lows15.shift()
    dropTaken(highs15, true)
    dropTaken(lows15, false)

    // which 15m zone did price just enter? (also counts visits on every zone)
    Zone lHit = visitZones(mDems)
    Zone sHit = visitZones(mSups)
    bool nearDem = nearHtfZone(dDems) or nearHtfZone(hDems)
    bool nearSup = nearHtfZone(dSups) or nearHtfZone(hSups)

    // 5m change of character: a CLOSE beyond the last 5m swing
    bool choUp = not na(swHi5) and close > swHi5
    bool choDn = not na(swLo5) and close < swLo5

    runHunt(huntL, lHit, choUp, pl5, new15Lo, mPL, nearDem)
    runHunt(huntS, sHit, choDn, ph5, new15Hi, mPH, nearSup)

    // a broken swing is used up
    if choUp
        swHi5 := na
    if choDn
        swLo5 := na

    // heartbeat for the Edge app (lets it manage stops and show where price is)
    if sendBars
        [n1, t1] = nearestZone(dDems, na, "")
        [n2, t2] = nearestZone(dSups, n1, t1)
        [n3, t3] = nearestZone(hDems, n2, t2)
        [n4, nearTxt] = nearestZone(hSups, n3, t3)
        alert('{"secret":"' + secret + '","type":"bar","symbol":"' + syminfo.ticker + '","tv":"' + syminfo.tickerid +
             '","price":' + f(close) + ',"high":' + f(high) + ',"low":' + f(low) + ',"swing15Low":' + f(mPL) + ',"swing15High":' + f(mPH) +
             ',"trendD":' + str.tostring(trendD) + ',"trend4h":' + str.tostring(trend4h) + ',"near":"' + nearTxt + '"}', alert.freq_once_per_bar_close)

// ---------- Status panel
var table panel = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 15), border_width = 1, force_overlay = true)
trendTxt(int t) => t == 1 ? "UP" : t == -1 ? "DOWN" : "none yet"
trendCol(int t) => t == 1 ? color.lime : t == -1 ? color.red : color.silver
huntTxt(Hunt h) =>
    h.state == 3 ? "LIMIT " + fm(h.entry) + " · SL " + fm(h.sl) + " · TP " + fm(h.tp) + " (" + str.tostring(h.rr, "0.0") + "R)" :
     h.state == 2 ? "5m change of character — looking for the gap" :
     h.state == 1 ? "in a 15m zone — wait for a 5m close beyond the last swing" :
     "waiting for a fresh 15m zone"
if barstate.islast
    table.cell(panel, 0, 0, "EDGE radar", text_color = color.white, text_size = size.normal)
    table.cell(panel, 1, 0, syminfo.ticker + (inSess ? " · session open" : " · session closed"), text_color = inSess ? color.lime : color.gray, text_size = size.small)
    table.cell(panel, 0, 1, "Daily trend", text_color = cD, text_size = size.small)
    table.cell(panel, 1, 1, trendTxt(trendD), text_color = trendCol(trendD), text_size = size.small)
    table.cell(panel, 0, 2, "4H trend", text_color = c4h, text_size = size.small)
    table.cell(panel, 1, 2, trendTxt(trend4h), text_color = trendCol(trend4h), text_size = size.small)
    table.cell(panel, 0, 3, "Trade side", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 3, bias == 1 ? "LONGS (shorts only from a 4H/D supply)" : bias == -1 ? "SHORTS (longs only from a 4H/D demand)" : "only from 4H/D zones", text_color = trendCol(bias), text_size = size.small)
    table.cell(panel, 0, 4, "Long", text_color = color.lime, text_size = size.small)
    table.cell(panel, 1, 4, huntTxt(huntL), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 5, "Short", text_color = color.red, text_size = size.small)
    table.cell(panel, 1, 5, huntTxt(huntS), text_color = color.white, text_size = size.small)
    if timeframe.period != "5"
        table.cell(panel, 0, 6, "Chart", text_color = color.orange, text_size = size.small)
        table.cell(panel, 1, 6, "Use a 5-minute chart — the steps are built for it", text_color = color.orange, text_size = size.small)
