// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
//
// EDGE — Supply & Demand scanner (1H zones · 5m confirmation)
// ---------------------------------------------------------------------------
// Put it on a 5-minute chart of each market you trade. One alert per chart.
// At the bottom: a clean add-on (80 SMA + Volume Profile POC / VAH / VAL lines) for context only.
//
//   1. 1H trend    : a 1H candle CLOSES past the last 1H swing = break of structure (BOS).
//                    Trade only when the last two BOS point the same way.
//   2. 1H zone     : at the latest BOS, the origin of the move: the last 1–3 opposite candles
//                    (demand = down-close candles) — from their body top to the lowest low of the move.
//                    Only the most recent zone, first return only. A 1H close through it kills it.
//   3. Return      : price touches the zone.
//   4. 5m shift    : a 5m candle closes past the last 5m swing made before the low (high).
//   5. Entry       : limit at the top of the last fair value gap of that move; if none, at the
//                    breaker / mitigation block (the candles of the broken swing).
//   6. Stop        : 2 ticks past the low of the move. Target: 1:3, plus the HIGHEST target: the 1H high
//                    (low) the move came from, at most 10R — your call.
//   7. 30% fill    : price usually fills ~30% of a fresh zone before it turns (dotted line). A 5m MSS
//                    before that is flagged "may go deeper" — not blocked (tested: blocking it doesn't
//                    raise the win rate).
//   8. Too far     : a small sweep past the zone is fine (liquidity); if price pushed more than 1× the 1H
//                    average range past it, no setup.
//   9. MB entry    : mitigation block — after the low in the zone: swing high (top of the first rally), a
//                    HIGHER low, then a strong close above that swing high. Block = the last 1–3 up-close
//                    candles of the rally (at least 2, wick to wick); limit at its top, stop under the higher low. It is
//                    its own alert ("MB") and doesn't use up the zone (the FVG setup can still follow).
//  10. BB entry    : breaker block — swing low → swing high → LOWER low (takes the first low) → quick close above
//                    the swing high (≤ 12 candles). Breaker = the last 2–3 up-close candles between the first low
//                    and the swing high, wick to wick; limit at its top, stop under the lower low. Replaces the FVG
//                    entry when it is there (tested: +177R → +199R on 9 markets).
//  11. No ranging  : no setup when price moved less than 1× the 1H average range in the 2 hours before the
//                    break (stagnant / consolidating). Tested: win rate 36% → 38%, +199R → +254R.
//  12. A+         : setups where price came into the zone fast or trended hard before the break (choppiness
//                    ≤ 40 / ≤ 45) are marked A+ (tested 44–47% win vs 38%). Every setup is sent; Edge alerts you to
//                    A+ ones, and to the others only after 4 days without a trade (the account's 7-day rule).
//   Orders only 03:00–11:00 New York (London open → New York morning: the busy, high-volume hours). Edge keeps the setup 4 hours;
//   trades can run until your close-out (16:40 New York in Edge).
//
// CLEAN chart (default): only the live 1H zone with its 30% line and, when a setup fires, the latest one:
// the 5m liquidity taken ($$$), the MSS 5m line, the FVG (extended right) and the ENTRY line with the plan
// written next to it: entry, stop, 1:3 target (recommended) and the highest target. No long / short boxes
// (switch "Long / short boxes" on if you want them). The 4H zone, older zones and the 1H BOS / MSS labels
// can be switched on in the settings. Orders 03:00–11:00 New York = London open → New York morning.
//
// For the Edge app, create ONE alert on this chart:
//   Condition: this script → "Any alert() function call"
//   Webhook URL: https://<your-edge-app>/api/hook
//   Message: leave as is (the script writes its own JSON)
// ---------------------------------------------------------------------------
//@version=6
indicator("Edge — Supply & Demand scanner (1H · 5m)", shorttitle = "Edge S&D", overlay = true, max_bars_back = 600, max_boxes_count = 200, max_lines_count = 200, max_labels_count = 200)

secret = input.string("change-me", "Edge webhook secret", group = "Edge app alerts")
alertMode = input.string("Edge webhook", "Alerts go to", options = ["Edge webhook", "TradingView app (plain text)"], group = "Edge app alerts", tooltip = "No two-factor authentication on TradingView yet? Pick the TradingView app: you get a readable notification on your phone instead of the Edge webhook.")
htf = input.timeframe("60", "Zone timeframe", group = "Rules")
tpR = input.float(3, "Target (R)", step = 0.5, group = "Rules")
fromH = input.int(3, "Orders from (New York hour)", group = "Rules")
toHM = input.int(1100, "Orders until (New York, HHMM)", group = "Rules")
showZone = input.bool(true, "Draw the 1H zone", group = "Chart")
showZone4 = input.bool(false, "Draw the 4H zone", group = "Chart")
showOlder = input.bool(false, "Draw an older 1H zone too", group = "Chart")
showBos = input.bool(true, "Label 1H BOS / CHoCH", group = "Chart")
showPanel = input.bool(true, "Trend panel (top right)", group = "Chart")
showFill = input.bool(true, "Dotted 30% line inside the 1H zone", group = "Chart", tooltip = "Price usually fills about 30% of a fresh zone before it turns. A 5m MSS before that line: it may go deeper first (you could become the liquidity).")
showTrade = input.bool(true, "Draw the latest setup: liquidity taken, MSS 5m, FVG and the entry", group = "Chart")
showBoxes = input.bool(true, "Long / short boxes (stop and target) on every setup", group = "Chart")
maxPast = input.float(1.0, "No setup if price pushed this far past the zone (× 1H average range); a small sweep is fine", step = 0.25, group = "Rules")
onlyAPlus = input.bool(false, "Only send TAKE setups (off = send all, each marked TAKE or SKIP)", group = "Rules", tooltip = "TAKE = A+ (price trended / came in fast) OR zone score 0+ while price isn't choppy (choppiness ≤ 55). Tested 2019–Sep 2026, 9 markets, 1:3: about 3 a week, 40% win in both 2019–22 and 2023–26.")
minMove = input.float(1.0, "No trading in a range: price must have moved at least this × 1H average range in the last 2 hours", step = 0.25, group = "Rules")
showBB = input.bool(true, "Breaker block entries (swing low → swing high → LOWER low → quick close above)", group = "Rules")
showMB = input.bool(true, "Mitigation block entries (swing low → swing high → higher low → strong close above)", group = "Rules")
maxR = input.float(10, "Highest target (R) — the 1H high / low the move came from, capped here", step = 0.5, group = "Rules")
showTradeLabel = input.bool(false, "Price label next to the trade", group = "Chart")
planWhere = input.string("Panel", "Trade plan text", options = ["Panel", "On the chart", "Both"], group = "Chart", tooltip = "Panel: the plan (entry, stop, targets, volume) is written in the panel, easy to read on a phone. The chart keeps only the lines with short tags.")
panelPos = input.string("Top right", "Panel position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = "Chart")
panelSize = input.string("Normal", "Panel text size", options = ["Small", "Normal", "Large"], group = "Chart")

// ---------- the 1H side: trend (two BOS the same way) and the zone of the latest BOS
sdState() =>
    var float lastH = na
    var int lastHi = na
    var bool brokeH = true
    var float lastL = na
    var int lastLi = na
    var bool brokeL = true
    var int prevDir = 0
    var int cnt = 0
    var int zDir = 0
    var float zTop = na
    var float zBot = na
    var int zId = 0
    var float zExt = na
    var int zT = na
    var float zWick = na // the zone runs wick to wick: this is the wick edge (drawn light); the body edge arms alerts
    var float z2Wick = na
    var int z2Dir = 0 // the zone before it, kept while it points the same way and isn't broken
    var float z2Top = na
    var float z2Bot = na
    var int z2T = na
    var float bLvl = na
    var int bT0 = na
    var int bT1 = na
    var int bDir = 0
    var bool bCh = false
    var int bId = 0
    atr = ta.atr(14)
    ph = ta.pivothigh(high, 2, 2)
    pl = ta.pivotlow(low, 2, 2)
    if not na(ph)
        lastH := ph
        lastHi := bar_index - 2
        brokeH := false
    if not na(pl)
        lastL := pl
        lastLi := bar_index - 2
        brokeL := false
    // a close through the far side kills the zone
    if zDir == 1 and close < zBot
        zDir := 0
    if zDir == -1 and close > zTop
        zDir := 0
    if z2Dir == 1 and close < z2Bot
        z2Dir := 0
    if z2Dir == -1 and close > z2Top
        z2Dir := 0
    for d in array.from(1, -1)
        bool hit = d == 1 ? (not brokeH and not na(lastH) and close > lastH) : (not brokeL and not na(lastL) and close < lastL)
        if hit
            int sw = d == 1 ? lastHi : lastLi
            if d == 1
                brokeH := true
            else
                brokeL := true
            // the break itself, for the chart: BOS = same way as the last one, MSS = the first one the other way
            bLvl := d == 1 ? lastH : lastL
            bT0 := time[bar_index - sw]
            bT1 := time
            bDir := d
            bCh := prevDir != 0 and d != prevDir
            bId += 1
            cnt := d == prevDir ? cnt + 1 : 1
            prevDir := d
            int span = math.min(bar_index - sw, 400)
            // origin: the extreme between the broken swing and this candle
            int o = 0
            for k = 0 to span
                if d == 1 ? low[k] < low[o] : high[k] > high[o]
                    o := k
            // the last 1–3 opposite candles at the origin
            bool oppO = d == 1 ? close[o] < open[o] : close[o] > open[o]
            bool oppO1 = d == 1 ? close[o + 1] < open[o + 1] : close[o + 1] > open[o + 1]
            int a = (not oppO and oppO1) ? o + 1 : o
            int n = 0
            float near = na
            float wnear = na
            for k = a to a + 2
                bool opp = d == 1 ? close[k] < open[k] : close[k] > open[k]
                if not opp
                    break
                // an older opposite candle joins only if it sits inside the last one's range (a base), not a step of the drop
                if n > 0 and (d == 1 ? math.max(open[k], close[k]) > high[a] : math.min(open[k], close[k]) < low[a])
                    break
                n += 1
                near := d == 1 ? math.max(nz(near, -1e10), math.max(open[k], close[k])) : math.min(nz(near, 1e10), math.min(open[k], close[k]))
                wnear := d == 1 ? math.max(nz(wnear, -1e10), high[k]) : math.min(nz(wnear, 1e10), low[k])
            int oldest = n > 0 ? a + n - 1 : o
            if n == 0
                near := d == 1 ? math.max(open[o], close[o]) : math.min(open[o], close[o])
                wnear := d == 1 ? high[o] : low[o]
            float far = d == 1 ? low[oldest] : high[oldest]
            for k = 0 to oldest
                far := d == 1 ? math.min(far, low[k]) : math.max(far, high[k])
            float zt = d == 1 ? near : far
            float zb = d == 1 ? far : near
            // the current zone becomes the older one if it points the same way; a break the other way clears it
            if zDir == d
                z2Dir := d
                z2Top := zTop
                z2Bot := zBot
                z2T := zT
                z2Wick := zWick
            else if z2Dir != d
                z2Dir := 0
            if zt - zb > 0 and zt - zb <= 3 * atr
                zDir := d
                zTop := zt
                zBot := zb
                zId += 1
                zT := time[oldest]
                zWick := wnear
                zExt := d == 1 ? high : low
            else
                zDir := 0
    if zDir != 0
        zExt := zDir == 1 ? math.max(zExt, high) : math.min(zExt, low)
    int ok = zDir != 0 and cnt >= 2 ? zDir : 0
    int ok2 = z2Dir != 0 and cnt >= 2 and z2Dir == prevDir ? z2Dir : 0
    [ok[1], zTop[1], zBot[1], zId[1], zT[1], bLvl[1], bT0[1], bT1[1], bDir[1], bCh[1], bId[1], prevDir[1], cnt[1], ok2[1], z2Top[1], z2Bot[1], z2T[1], zWick[1], z2Wick[1]]

// 4H trend: the direction of the last 4H close past a 4H swing
trendState() =>
    var float h = na
    var float l = na
    var int dir = 0
    ph = ta.pivothigh(high, 2, 2)
    pl = ta.pivotlow(low, 2, 2)
    if not na(ph)
        h := ph
    if not na(pl)
        l := pl
    if not na(h) and close > h
        dir := 1
        h := na
    if not na(l) and close < l
        dir := -1
        l := na
    dir[1]

[hDir, hTop, hBot, hId, hZT, bLvl, bT0, bT1, bDir, bCh, bId, hTrend, hCnt, h2Dir, h2Top, h2Bot, h2T, hW, h2W] = request.security(syminfo.tickerid, htf, sdState(), lookahead = barmerge.lookahead_on)
t4 = request.security(syminfo.tickerid, "240", trendState(), lookahead = barmerge.lookahead_on)
atr1h = request.security(syminfo.tickerid, htf, ta.atr(14)[1], lookahead = barmerge.lookahead_on)
// how much of the 1H zone price has filled, measured on the drawn zone (wick edge → far edge): 0 = just touched, 1 = all
hFar = hDir == 1 ? hBot : hTop
hNear = hDir == 1 ? (na(hW) ? hTop : math.max(hTop, hW)) : (na(hW) ? hBot : math.min(hBot, hW))
fillOf(float px) => hDir == 0 or hNear == hFar ? na : math.max(0.0, (hDir == 1 ? hNear - px : px - hNear) / math.abs(hNear - hFar))
fillTxt(float f) => na(f) ? "" : f > 1 ? "price wicked past the zone's far edge" : "zone filled " + str.tostring(math.round(f * 100)) + "%" + (f < 0.3 ? " (under 30%: may go deeper)" : "")
// the 4H zones: the same rules on 4H candles (drawn in their own colours, for context — alerts come from the 1H zone)
[x4Dir, x4Top, x4Bot, x4Id, x4ZT, x4bLvl, x4bT0, x4bT1, x4bDir, x4bCh, x4bId, x4Trend, x4Cnt, x42Dir, x42Top, x42Bot, x42T, x4W, x42W] = request.security(syminfo.tickerid, "240", sdState(), lookahead = barmerge.lookahead_on)
htfName = htf == "60" ? "1H" : htf == "240" ? "4H" : htf + "m"

// ---------- the 5m side
var int usedId = -1
var box sTp = na
var box sSl = na
var label sLab = na
var line sMss = na
var line sLiq = na
var label sMssT = na
var box sFvg = na
var int mbId = -1
var box mbBox = na
var line mbEnt = na
var line mbStop = na
var label mbLab = na
var line mbTpL = na
var label mbTpT = na
var label mbTags = na
var line mbMss = na
var line sEnt = na
var line sStop = na
var label sEntT = na
var line sSw = na
var label sSwT = na
var line sMax = na
var line sTpL = na
var label sTpT = na
var label sStopT = na
var label sEntTag = na
var string pSide = ""
var string pStop = ""
var string pLow = ""
var string pTgt = ""
var string pHigh = ""
var string pNote = ""
var string pScore = ""
var string pConf = ""
var box mbTpBox = na
var box mbSlBox = na
var int pTime = na
var label sMaxT = na
// the high (demand) / low (supply) of the move that left the 1H zone — buy-side / sell-side liquidity, the highest target
var float legExt = na
var int legId = -1
var int armId = -1
var float ext = na
var int extBar = na
var array<int> phI = array.new_int()
var array<float> phV = array.new_float()
var array<int> plI = array.new_int()
var array<float> plV = array.new_float()
p5h = ta.pivothigh(high, 2, 2)
p5l = ta.pivotlow(low, 2, 2)
if not na(p5h)
    array.push(phI, bar_index - 2)
    array.push(phV, p5h)
if not na(p5l)
    array.push(plI, bar_index - 2)
    array.push(plV, p5l)
if array.size(phI) > 300
    array.shift(phI)
    array.shift(phV)
if array.size(plI) > 300
    array.shift(plI)
    array.shift(plV)

if hDir != 0 and hId != legId
    legId := hId
    legExt := hDir == 1 ? high : low
    if not na(hZT)
        for k = 0 to 590
            if time[k] < hZT
                break
            legExt := hDir == 1 ? math.max(legExt, high[k]) : math.min(legExt, low[k])
else if hDir != 0 and armId != hId and hId != usedId
    legExt := hDir == 1 ? math.max(legExt, high) : math.min(legExt, low)

// zone score (tested Oct 19, 667 A+ trades 2019–Sep 2026): +1 mature (price back 11+ 1H candles after the break, 65% win),
// +1 room (the 1H high / low the move came from ≥ 2R away), +1 narrow zone (≤ ¾ of the 1H average range),
// −1 instant retest (back within 3 1H candles). Score −1 +0.17R/trade · 0 +0.12R · +1 +0.40R · +2 +0.85R.
zoneAge() => na(bT1) ? 0 : math.floor((time - bT1) / (timeframe.in_seconds(htf) * 1000)) - 1
zoneScore(float e, float r, int d) =>
    int ag = zoneAge()
    float room = na(legExt) or r <= 0 ? 0.0 : d * (legExt - e) / r
    float zh = na(atr1h) or atr1h <= 0 ? 9.0 : (hTop - hBot) / atr1h
    int sc = (ag > 10 ? 1 : 0) + (room >= 2 ? 1 : 0) + (zh <= 0.75 ? 1 : 0) - (ag <= 3 ? 1 : 0)
    string why = (ag > 10 ? "mature zone, " : "") + (room >= 2 ? "room " + str.tostring(room, "#.#") + "R, " : "") + (zh <= 0.75 ? "narrow zone, " : "") + (ag <= 3 ? "instant retest, " : "")
    [sc, why == "" ? "nothing extra" : str.substring(why, 0, str.length(why) - 2)]
scoreTxt(int sc) => (sc > 0 ? "+" : "") + str.tostring(sc) + (sc >= 2 ? " ★★" : sc == 1 ? " ★" : "")

nyH = hour(time_close, "America/New_York")
nyM = minute(time_close, "America/New_York")
hhmm = nyH * 100 + nyM
inWin = nyH >= fromH and hhmm < toHM
tick = syminfo.mintick
// volume: the candle that breaks vs the average of the last 20 candles (shown on every entry; not a rule yet — untested)
volAvg = ta.sma(volume, 20)[1]
// ranging / stagnant: the 2 hours (24 five-minute candles) before this one moved less than minMove × the 1H average range
rng2h = ta.highest(high, 24)[1] - ta.lowest(low, 24)[1]
stagnant = rng2h < minMove * atr1h
// choppiness of the 24 five-minute candles ending here (low = trending / fast, high = choppy). A+ = the 2 hours before
// the break were trending (≤ 45) or price came into the zone fast (the 2 hours up to the extreme ≤ 40)
chopRng = ta.highest(high, 24) - ta.lowest(low, 24)
ciCur = chopRng > 0 ? 100 * math.log10(math.sum(ta.tr(true), 24) / chopRng) / math.log10(24) : 100.0
aPlusNow() =>
    int back = bar_index - extBar
    float ciB = ciCur[1]
    float ciE = back >= 0 and back < 590 ? ciCur[back] : na
    ciB <= 45 or (not na(ciE) and ciE <= 40)
volX = volAvg > 0 ? volume / volAvg : na
volTxt = na(volX) ? "" : "volume " + str.tostring(volX, "#.#") + "× average" + (volX >= 1.5 ? " ✓" : volX < 1 ? " (weak)" : "")

var box zBox = na
var label zLab = na
var array<box> wickBoxes = array.new<box>()
var array<line> wickLines = array.new<line>()
var array<label> wickLabels = array.new<label>()
// the wick part of a zone (between the body edge and the wick edge), drawn lighter than the body part
wickPart(int t0, float body, float wick, color c) =>
    box.new(t0, math.max(body, wick), time, math.min(body, wick), xloc = xloc.bar_time, extend = extend.right, border_color = color.new(c, 70), bgcolor = color.new(c, 94), border_style = line.style_dotted)
var box z2Box = na
var label z2Lab = na
var box z4Box = na
var label z4Lab = na
var box z42Box = na
var label z42Lab = na
// 4H zones: demand green, supply pink (1H: demand blue, supply orange)
if barstate.islast
    while array.size(wickBoxes) > 0
        box.delete(array.pop(wickBoxes))
    while array.size(wickLines) > 0
        line.delete(array.pop(wickLines))
    while array.size(wickLabels) > 0
        label.delete(array.pop(wickLabels))
if showZone4 and barstate.islast
    box.delete(z4Box)
    label.delete(z4Lab)
    box.delete(z42Box)
    label.delete(z42Lab)
    if x4Dir != 0
        color c4 = x4Dir == 1 ? #26a69a : #d64578
        z4Box := box.new(nz(x4ZT, time - 300 * 300000), x4Top, time, x4Bot, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(c4, 20), bgcolor = color.new(c4, 88))
        if not na(x4W)
            array.push(wickBoxes, wickPart(nz(x4ZT, time - 300 * 300000), x4Dir == 1 ? x4Top : x4Bot, x4W, c4))
        z4Lab := label.new(time + 6 * timeframe.in_seconds() * 1000, x4Dir == 1 ? x4Bot : x4Top, "4H " + (x4Dir == 1 ? "DEMAND" : "SUPPLY"), xloc = xloc.bar_time, style = label.style_label_left, color = c4, textcolor = color.white, size = size.normal)
    bool ov4 = x4Dir != 0 and x42Bot <= x4Top and x42Top >= x4Bot
    if x42Dir != 0 and x42Dir == x4Trend and not ov4
        color c42 = x42Dir == 1 ? #26a69a : #d64578
        z42Box := box.new(nz(x42T, time - 600 * 300000), x42Top, time, x42Bot, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(c42, 50), bgcolor = color.new(c42, 94))
        if not na(x42W)
            array.push(wickBoxes, wickPart(nz(x42T, time - 600 * 300000), x42Dir == 1 ? x42Top : x42Bot, x42W, c42))
        z42Lab := label.new(time + 6 * timeframe.in_seconds() * 1000, x42Dir == 1 ? x42Bot : x42Top, "4H " + (x42Dir == 1 ? "DEMAND" : "SUPPLY") + " (older)", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c42, 40), textcolor = color.white, size = size.small)
barMs = timeframe.in_seconds() * 1000
rightX = time + 6 * barMs // labels live in the empty space right of the last candle, never on the candles
if showZone and barstate.islast
    box.delete(zBox)
    label.delete(zLab)
    box.delete(z2Box)
    label.delete(z2Lab)
    // the older zone with the trend, only while the trend holds and it isn't broken
    // the older zone only when it makes sense: same way as the trend and clear of the newest zone (no overlap)
    bool overlap = hDir != 0 and h2Bot <= hTop and h2Top >= hBot
    bool in4 = x4Dir != 0 and h2Bot <= x4Top and h2Top >= x4Bot // an older 1H zone inside the 4H zone adds nothing
    if showOlder and h2Dir != 0 and h2Dir == hTrend and not overlap and not in4
        string z2Name = htfName + (h2Dir == 1 ? " DEMAND zone " : " SUPPLY zone ") + str.tostring(h2Bot, format.mintick) + "–" + str.tostring(h2Top, format.mintick) + " (older)"
        z2Box := box.new(nz(h2T, time - 300 * 300000), h2Top, time, h2Bot, xloc = xloc.bar_time, extend = extend.right, border_color = h2Dir == 1 ? color.new(#5aa9e6, 50) : color.new(#f08a4b, 50), bgcolor = h2Dir == 1 ? color.new(#5aa9e6, 92) : color.new(#f08a4b, 92))
        if not na(h2W)
            array.push(wickBoxes, wickPart(nz(h2T, time - 300 * 300000), h2Dir == 1 ? h2Top : h2Bot, h2W, h2Dir == 1 ? #5aa9e6 : #f08a4b))
        z2Lab := label.new(rightX, h2Dir == 1 ? h2Top : h2Bot, z2Name, xloc = xloc.bar_time, style = label.style_label_left, color = h2Dir == 1 ? color.new(#5aa9e6, 40) : color.new(#f08a4b, 40), textcolor = color.white, size = size.small)
    if hDir != 0
        string zName = htfName + (hDir == 1 ? " DEMAND zone " : " SUPPLY zone ") + str.tostring(hBot, format.mintick) + "–" + str.tostring(hTop, format.mintick) + (zoneAge() > 10 ? "  ★ mature" : "")
        zBox := box.new(nz(hZT, time - 150 * 300000), hTop, time, hBot, xloc = xloc.bar_time, extend = extend.right, border_color = hDir == 1 ? color.new(#5aa9e6, 30) : color.new(#f08a4b, 30), bgcolor = hDir == 1 ? color.new(#5aa9e6, 85) : color.new(#f08a4b, 85))
        if not na(hW)
            array.push(wickBoxes, wickPart(nz(hZT, time - 150 * 300000), hDir == 1 ? hTop : hBot, hW, hDir == 1 ? #5aa9e6 : #f08a4b))
        if showFill
            float l30 = hNear - (hDir == 1 ? 1 : -1) * 0.3 * math.abs(hNear - hFar)
            array.push(wickLines, line.new(nz(hZT, time - 150 * 300000), l30, time, l30, xloc = xloc.bar_time, extend = extend.right, color = color.new(hDir == 1 ? #5aa9e6 : #f08a4b, 10), style = line.style_dotted, width = 1))
            array.push(wickLabels, label.new(rightX, l30, "30%", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(#000000, 100), textcolor = hDir == 1 ? #5aa9e6 : #f08a4b, size = size.small))
        zLab := label.new(rightX, hDir == 1 ? hTop : hBot, zName, xloc = xloc.bar_time, style = label.style_label_left, color = hDir == 1 ? color.new(#5aa9e6, 0) : color.new(#f08a4b, 0), textcolor = color.white, size = size.normal)

// 1H breaks: only the last 3 BOS and the last MSS stay on the chart
var int lastBId = 0
var array<line> bosL = array.new<line>()
var array<label> bosT = array.new<label>()
var line chL = na
var label chT = na
if showBos and bId != lastBId and not na(bLvl) and not na(bT0)
    lastBId := bId
    color bc = bCh ? color.new(#f0c94b, 0) : (bDir == 1 ? color.new(#5aa9e6, 0) : color.new(#f08a4b, 0))
    line ln = line.new(bT0, bLvl, bT1, bLvl, xloc = xloc.bar_time, color = bc, width = 2)
    // the line runs from the swing to the candle that broke it; the name sits at its middle, on the side
    // with no candles (above a break up, below a break down)
    label lb = label.new(math.round((bT0 + bT1) / 2), bLvl, (bCh ? "CHoCH " : "BOS ") + htfName, xloc = xloc.bar_time, style = bDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(#000000, 100), textcolor = bc, size = size.small)
    if bCh
        line.delete(chL)
        label.delete(chT)
        chL := ln
        chT := lb
    else
        array.push(bosL, ln)
        array.push(bosT, lb)
        if array.size(bosL) > 3
            line.delete(array.shift(bosL))
            label.delete(array.shift(bosT))

if barstate.isconfirmed and hDir != 0 and hId != usedId
    d = hDir
    if armId != hId
        if d == 1 ? low <= hTop : high >= hBot
            armId := hId
            ext := d == 1 ? low : high
            extBar := bar_index
    if armId == hId
        if d == 1 ? low < ext : high > ext
            ext := d == 1 ? low : high
            extBar := bar_index
        // the last 5m swing made before the extreme
        int swI = na
        float swV = na
        ids = d == 1 ? phI : plI
        vals = d == 1 ? phV : plV
        int sz = array.size(ids)
        if sz > 0
            for j = sz - 1 to 0
                int ii = array.get(ids, j)
                if ii < extBar - 120
                    break
                if ii < extBar
                    swI := ii
                    swV := array.get(vals, j)
                    break
        // ---- MITIGATION BLOCK (5m): after the low in the zone (L1) a swing high H (top of the first rally), then a
        // HIGHER low, then a strong candle (body ≥ half) CLOSES above H. Block = the last 1–3 up-close candles of the
        // rally into H, wick to wick; buy limit at its top, stop 2 ticks under the higher low. Sells mirrored.
        // It doesn't use up the zone: the normal FVG setup can still come after it.
        if showMB and mbId != hId and inWin and not na(extBar)
            int nB = math.min(bar_index - extBar - 1, 150)
            if nB >= 6
                int kH = na
                for k = 1 to nB
                    if na(kH) or (d == 1 ? high[k] > high[kH] : low[k] < low[kH])
                        kH := k
                int kL = na
                if kH >= 4
                    for k = 1 to kH - 1
                        if na(kL) or (d == 1 ? low[k] < low[kL] : high[k] > high[kL])
                            kL := k
                bool okH = not na(kH) and kH >= 4 and kH <= nB - 2 and (d == 1 ? high[kH] >= math.max(high[kH - 1], high[kH - 2], high[kH + 1], high[kH + 2]) : low[kH] <= math.min(low[kH - 1], low[kH - 2], low[kH + 1], low[kH + 2]))
                bool okL = not na(kL) and kL >= 3 and (d == 1 ? low[kL] <= math.min(low[kL - 1], low[kL - 2], low[kL + 1], low[kL + 2]) and low[kL] > ext : high[kL] >= math.max(high[kL - 1], high[kL - 2], high[kL + 1], high[kL + 2]) and high[kL] < ext)
                bool strong = math.abs(close - open) >= 0.5 * (high - low)
                if okH and okL and strong and (d == 1 ? close > high[kH] : close < low[kH])
                    mbId := hId
                    int k0 = kH
                    while k0 < nB and not (d == 1 ? close[k0] > open[k0] : close[k0] < open[k0])
                        k0 += 1
                    float bTop = high[k0]
                    float bBot = low[k0]
                    int kEnd = k0
                    for k = k0 to math.min(k0 + 2, nB)
                        if not (d == 1 ? close[k] > open[k] : close[k] < open[k])
                            break
                        bTop := math.max(bTop, high[k])
                        bBot := math.min(bBot, low[k])
                        kEnd := k
                    bool twoPlus = kEnd - k0 >= 1 // 2–3 candles: a real block, not a single candle
                    float me = d == 1 ? bTop : bBot
                    float msl = (d == 1 ? low[kL] : high[kL]) - d * 2 * tick
                    float mr = math.abs(me - msl)
                    bool mFar = (d == 1 ? hFar - ext : ext - hFar) > maxPast * atr1h
                    bool mPlus = aPlusNow()
                    if d * (me - msl) > 0 and mr >= 4 * tick and not mFar and twoPlus and not stagnant
                        float mtp = me + d * tpR * mr
                        float mtpMax = na(legExt) ? mtp : me + d * math.max(tpR * mr, math.min(d * (legExt - me), maxR * mr))
                        float mrrMax = math.abs(mtpMax - me) / mr
                        [mSc, mWhy] = zoneScore(me, mr, d)
                        bool mGo = mPlus or (mSc >= 0 and ciCur[1] <= 55)
                        float mfill = fillOf(ext)
                        box.delete(mbBox)
                        box.delete(mbTpBox)
                        box.delete(mbSlBox)
                        line.delete(mbEnt)
                        line.delete(mbStop)
                        label.delete(mbLab)
                        line.delete(mbMss)
                        line.delete(mbTpL)
                        label.delete(mbTpT)
                        label.delete(mbTags)
                        pSide := (mGo ? "✅ TAKE · " : "⛔ SKIP · ") + (mPlus ? "A+ " : "") + (d == 1 ? "BUY limit " : "SELL limit ") + str.tostring(me, format.mintick) + " (MB)"
                        pStop := str.tostring(msl, format.mintick)
                        pLow := "1:2 → " + str.tostring(me + d * 2 * mr, format.mintick)
                        pTgt := "1:" + str.tostring(tpR, "#.#") + " → " + str.tostring(mtp, format.mintick) + "  ✓"
                        pHigh := mrrMax > tpR + 0.25 ? "1:" + str.tostring(mrrMax, "#.#") + " → " + str.tostring(mtpMax, format.mintick) : "—"
                        pNote := (not na(mfill) and mfill < 0.3 ? "⚠ zone filled " + str.tostring(math.round(mfill * 100)) + "% (under 30%)  " : "") + volTxt
                        pScore := scoreTxt(mSc) + "  (" + mWhy + ")"
                        pConf := "Mitigation block (2nd entry)" + (mPlus ? " · A+" : "") + (t4 == d ? " · with 4H" : t4 == -d ? " · against 4H" : "") + (not na(mfill) and mfill >= 0.3 ? " · filled 30%+" : "") + (not na(volX) and volX >= 1.5 ? " · strong volume" : "")
                        pTime := time
                        if showTrade
                            mbBox := box.new(bar_index - kEnd, bTop, bar_index + 30, bBot, border_color = color.new(#777777, 20), bgcolor = color.new(#777777, 80), text = "MB", text_size = size.tiny, text_color = #555555, text_halign = text.align_left)
                            mbEnt := line.new(bar_index - kEnd, me, bar_index + 30, me, color = color.new(#8e44ad, 0), width = 2)
                            mbStop := line.new(bar_index, msl, bar_index + 30, msl, color = color.new(#ef5350, 0), style = line.style_dotted, width = 1)
                            mbMss := line.new(bar_index - kH, d == 1 ? high[kH] : low[kH], bar_index, d == 1 ? high[kH] : low[kH], color = color.new(#e0b000, 0), width = 2)
                            if showBoxes
                                mbTpBox := box.new(bar_index, d == 1 ? mtp : me, bar_index + 30, d == 1 ? me : mtp, border_color = color.new(#26a69a, 20), bgcolor = color.new(#26a69a, 85), text = "target " + str.tostring(mtp, format.mintick) + " (1:" + str.tostring(tpR, "#.#") + ")", text_size = size.small, text_color = #26a69a, text_halign = text.align_left, text_valign = d == 1 ? text.align_top : text.align_bottom)
                                mbSlBox := box.new(bar_index, d == 1 ? me : msl, bar_index + 30, d == 1 ? msl : me, border_color = color.new(#ef5350, 20), bgcolor = color.new(#ef5350, 85), text = "limit " + str.tostring(me, format.mintick) + " · stop " + str.tostring(msl, format.mintick), text_size = size.small, text_color = #ef5350, text_halign = text.align_left, text_valign = d == 1 ? text.align_bottom : text.align_top)
                            mbTpL := line.new(bar_index, mtp, bar_index + 30, mtp, color = color.new(#26a69a, 0), style = line.style_dashed, width = 2)
                            mbTpT := label.new(bar_index, mtp, "TP 1:" + str.tostring(tpR, "#.#") + "  " + str.tostring(mtp, format.mintick), style = d == 1 ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(#000000, 100), textcolor = #26a69a, size = size.normal)
                            mbTags := label.new(bar_index, msl, "SL " + str.tostring(msl, format.mintick), style = d == 1 ? label.style_label_upper_left : label.style_label_lower_left, color = color.new(#000000, 100), textcolor = #ef5350, size = size.normal)
                            if planWhere != "Panel"
                                mbLab := label.new(bar_index + 30, me, (mPlus ? "A+ " : "") + (d == 1 ? "BUY" : "SELL") + " ENTRY " + str.tostring(me, format.mintick) + " (MB)\nstop " + str.tostring(msl, format.mintick) + (tpR > 2 ? "\nlowest 1:2 → " + str.tostring(me + d * 2 * mr, format.mintick) : "") + "\ntarget 1:" + str.tostring(tpR, "#.#") + " → " + str.tostring(mtp, format.mintick) + "  ✓ default" + (mrrMax > tpR + 0.25 ? "\nhighest 1:" + str.tostring(mrrMax, "#.#") + " → " + str.tostring(mtpMax, format.mintick) + " (max 1:" + str.tostring(maxR, "#") + ")" : "") + (volTxt == "" ? "" : "\n" + volTxt), style = label.style_label_left, color = color.new(#000000, 100), textcolor = #8e44ad, size = size.normal, textalign = text.align_left)
                        string mside = d == 1 ? "long" : "short"
                        string mtxt = (mGo ? "✅ TAKE " : "⛔ SKIP ") + (mPlus ? "A+ " : "") + syminfo.ticker + " " + (d == 1 ? "BUY" : "SELL") + " limit " + str.tostring(me, format.mintick) + " · SL " + str.tostring(msl, format.mintick) + " · TP " + str.tostring(mtp, format.mintick) + " (1:" + str.tostring(tpR, "#.#") + ", MITIGATION BLOCK) · " + htfName + (d == 1 ? " demand " : " supply ") + str.tostring(hBot, format.mintick) + "–" + str.tostring(hTop, format.mintick) + (mrrMax > tpR + 0.25 ? " · highest target " + str.tostring(mtpMax, format.mintick) + " (" + str.tostring(mrrMax, "#.#") + "R)" : "") + (na(mfill) ? "" : " · " + fillTxt(mfill)) + (volTxt == "" ? "" : " · " + volTxt) + " · zone score " + scoreTxt(mSc) + " (" + mWhy + ")"
                        if (mGo or not onlyAPlus) and alertMode == "Edge webhook"
                            alert('{"secret":"' + secret + '","type":"setup","strategy":"sd","symbol":"' + syminfo.ticker + '","tv":"' + syminfo.tickerid + '","dir":"' + mside + '","entry":' + str.tostring(me) + ',"sl":' + str.tostring(msl) + ',"tp":' + str.tostring(mtp) + ',"rr":' + str.tostring(tpR, "#.##") + ',"kind":"MB","aplus":' + (mPlus ? "true" : "false") + ',"vol":' + (na(volX) ? "null" : str.tostring(volX, "#.##")) + ',"zoneTop":' + str.tostring(hTop) + ',"zoneBot":' + str.tostring(hBot) + ',"mss":' + str.tostring(d == 1 ? high[kH] : low[kH]) + ',"liq":null,"liqR":null,"trend4h":' + str.tostring(t4) + ',"tpMax":' + str.tostring(mtpMax) + ',"rrMax":' + str.tostring(mrrMax, "#.##") + ',"fill":' + (na(mfill) ? "null" : str.tostring(mfill, "#.##")) + ',"go":' + (mGo ? "true" : "false") + ',"score":' + str.tostring(mSc) + ',"scoreWhy":"' + mWhy + '","validMin":240}', alert.freq_once_per_bar_close)
                        else if mGo or not onlyAPlus
                            alert(mtxt, alert.freq_once_per_bar_close)
        if not na(swV) and (d == 1 ? close > swV : close < swV)
            usedId := hId
            armId := -1
            if inWin
                int back = bar_index - swI
                float leg = d == 1 ? low : high
                for k = 0 to back
                    leg := d == 1 ? math.min(leg, low[k]) : math.max(leg, high[k])
                float sl = leg - d * 2 * tick
                float fill = fillOf(leg)
                // a small sweep past the zone is fine (liquidity); pushed far through it = no setup
                bool tooFar = (d == 1 ? hFar - leg : leg - hFar) > maxPast * atr1h
                // fair value gap (the last one of the move)
                float fvg = na
                int fvgK = na
                if back >= 2
                    for k = back - 2 to 0
                        if d == 1 ? low[k] > high[k + 2] : high[k] < low[k + 2]
                            fvg := d == 1 ? low[k] : high[k]
                            fvgK := k
                // block: the candles of the broken swing
                int bOff = back
                float bHi = high[bOff]
                float bLo = low[bOff]
                for k = bOff to bOff + 2
                    bool same = d == 1 ? close[k] > open[k] : close[k] < open[k]
                    if not same
                        break
                    bHi := math.max(bHi, high[k])
                    bLo := math.min(bLo, low[k])
                string kind = na(fvg) ? "block" : "FVG"
                float e = na(fvg) ? (d == 1 ? bHi : bLo) : fvg
                // BREAKER BLOCK: a swing low (L1) before the swing just broken, then a LOWER low (the extreme took L1),
                // then a quick break (≤ 12 candles from the low). Breaker = the last 2–3 up-close candles between L1
                // and the swing high, wick to wick; buy limit at its top. It replaces the FVG entry when it is there.
                int bbK0 = na
                int bbK1 = na
                if showBB and bar_index - extBar <= 12
                    int l1I = na
                    float l1V = na
                    oI = d == 1 ? plI : phI
                    oV = d == 1 ? plV : phV
                    int oS = array.size(oI)
                    if oS > 0
                        for j = oS - 1 to 0
                            int ii = array.get(oI, j)
                            if ii < swI - 80
                                break
                            if ii < swI
                                l1I := ii
                                l1V := array.get(oV, j)
                                break
                    if not na(l1I) and (d == 1 ? l1V > ext : l1V < ext)
                        int kS = bar_index - swI
                        int kL1 = bar_index - l1I
                        while kS < kL1 and not (d == 1 ? close[kS] > open[kS] : close[kS] < open[kS])
                            kS += 1
                        float tTop = high[kS]
                        float tBot = low[kS]
                        int kE = kS
                        for k = kS to math.min(kS + 2, kL1 - 1)
                            if not (d == 1 ? close[k] > open[k] : close[k] < open[k])
                                break
                            tTop := math.max(tTop, high[k])
                            tBot := math.min(tBot, low[k])
                            kE := k
                        if kE - kS >= 1
                            kind := "breaker"
                            e := d == 1 ? tTop : tBot
                            bbK0 := kE
                            bbK1 := kS
                            bHi := tTop
                            bLo := tBot
                float r = math.abs(e - sl)
                bool aPlus = aPlusNow()
                if d * (e - sl) > 0 and r >= 4 * tick and not tooFar and not stagnant
                    // target 1:tpR (default 1:2); the nearest 5m swing in the way is sent so you can judge the room
                    float tp = e + d * tpR * r
                    float liq = na
                    tids = d == 1 ? phI : plI
                    tvals = d == 1 ? phV : plV
                    int ts = array.size(tids)
                    if ts > 0
                        for j = ts - 1 to 0
                            if array.get(tids, j) < bar_index - 400
                                break
                            float v = array.get(tvals, j)
                            if d * (v - e) > 0
                                liq := na(liq) ? v : (d == 1 ? math.min(liq, v) : math.max(liq, v))
                    float rr = math.abs(tp - e) / r
                    // the highest target: the 1H high (buy) / low (sell) the move came from, at least the 1:tpR target, at most maxR
                    float tpMax = na(legExt) ? tp : e + d * math.max(tpR * r, math.min(d * (legExt - e), maxR * r))
                    float rrMax = math.abs(tpMax - e) / r
                    [zSc, zWhy] = zoneScore(e, r, d)
                    bool zGo = aPlus or (zSc >= 0 and ciCur[1] <= 55) // TAKE: ~3 a week, 40% win in the tests
                    // the 5m liquidity the leg took: the last 5m low (buy) / high (sell) before the extreme that it ran
                    int sweepI = na
                    float sweepV = na
                    oids = d == 1 ? plI : phI
                    ovals = d == 1 ? plV : phV
                    int os = array.size(oids)
                    if os > 0
                        for j = os - 1 to 0
                            int oi = array.get(oids, j)
                            if oi < bar_index - 150
                                break
                            float ov = array.get(ovals, j)
                            if oi < extBar and (d == 1 ? ov > leg : ov < leg)
                                sweepI := oi
                                sweepV := ov
                                break
                    string side = d == 1 ? "long" : "short"
                    if kind == "block" and na(bbK0)
                        float prevExt = d == 1 ? low[back + 1] : high[back + 1]
                        for k = back + 1 to back + 30
                            prevExt := d == 1 ? math.min(prevExt, low[k]) : math.max(prevExt, high[k])
                        kind := (d == 1 ? leg < prevExt : leg > prevExt) ? "breaker" : "mitigation"
                    // the long / short box at the limit — only the latest setup stays on the chart
                    box.delete(sFvg)
                    line.delete(sEnt)
                    line.delete(sStop)
                    label.delete(sEntT)
                    line.delete(sSw)
                    label.delete(sSwT)
                    line.delete(sMax)
                    label.delete(sMaxT)
                    line.delete(sTpL)
                    label.delete(sTpT)
                    label.delete(sStopT)
                    label.delete(sEntTag)
                    box.delete(sTp)
                    box.delete(sSl)
                    label.delete(sLab)
                    line.delete(sMss)
                    line.delete(sLiq)
                    label.delete(sMssT)
                    pSide := (zGo ? "✅ TAKE · " : "⛔ SKIP · ") + (aPlus ? "A+ " : "") + (d == 1 ? "BUY limit " : "SELL limit ") + str.tostring(e, format.mintick) + " (" + kind + ")"
                    pStop := str.tostring(sl, format.mintick)
                    pLow := "1:2 → " + str.tostring(e + d * 2 * r, format.mintick)
                    pTgt := "1:" + str.tostring(tpR, "#.#") + " → " + str.tostring(tp, format.mintick) + "  ✓"
                    pHigh := rrMax > tpR + 0.25 ? "1:" + str.tostring(rrMax, "#.#") + " → " + str.tostring(tpMax, format.mintick) : "—"
                    pNote := (not na(fill) and fill < 0.3 ? "⚠ zone filled " + str.tostring(math.round(fill * 100)) + "% (under 30%)  " : "") + volTxt
                    pScore := scoreTxt(zSc) + "  (" + zWhy + ")"
                    pConf := (kind == "breaker" ? "Breaker block" : kind == "mitigation" ? "Mitigation block" : kind) + (not na(fvgK) and kind != "breaker" ? " · FVG" : "") + (aPlus ? " · A+" : "") + (t4 == d ? " · with 4H" : t4 == -d ? " · against 4H" : "") + (not na(fill) and fill >= 0.3 ? " · filled 30%+" : "") + (not na(sweepI) ? " · liquidity taken" : "") + (not na(volX) and volX >= 1.5 ? " · strong volume" : "")
                    pTime := time
                    if showTrade
                        int x2 = bar_index + 30
                        int x1 = kind == "breaker" ? bar_index - bbK0 : na(fvgK) ? bar_index : bar_index - fvgK - 2
                        if showBoxes
                            sTp := box.new(bar_index, d == 1 ? tp : e, x2, d == 1 ? e : tp, border_color = color.new(#26a69a, 20), bgcolor = color.new(#26a69a, 85), text = "target " + str.tostring(tp, format.mintick) + " (1:" + str.tostring(tpR, "#.#") + ")", text_size = size.small, text_color = #26a69a, text_halign = text.align_left, text_valign = d == 1 ? text.align_top : text.align_bottom)
                            sSl := box.new(bar_index, d == 1 ? e : sl, x2, d == 1 ? sl : e, border_color = color.new(#ef5350, 20), bgcolor = color.new(#ef5350, 85), text = "limit " + str.tostring(e, format.mintick) + " · stop " + str.tostring(sl, format.mintick), text_size = size.small, text_color = #ef5350, text_halign = text.align_left, text_valign = d == 1 ? text.align_bottom : text.align_top)
                            if rrMax > tpR + 0.25
                                sMax := line.new(bar_index, tpMax, x2, tpMax, color = color.new(#26a69a, 0), style = line.style_dashed, width = 2)
                                sMaxT := label.new(x2, tpMax, "highest target " + str.tostring(tpMax, format.mintick) + " (" + str.tostring(rrMax, "#.#") + "R)", style = label.style_label_left, color = color.new(#000000, 100), textcolor = #26a69a, size = size.small)
                        else
                            // no boxes: the entry line at the FVG edge, the stop dotted, and the plan written next to it
                            sEnt := line.new(x1, e, x2, e, color = color.new(#8e44ad, 0), width = 2)
                            sStop := line.new(bar_index, sl, x2, sl, color = color.new(#ef5350, 0), style = line.style_dotted, width = 1)
                            string plan = (aPlus ? "A+ " : "") + (d == 1 ? "BUY" : "SELL") + " ENTRY " + str.tostring(e, format.mintick) + " (" + kind + ")\nstop " + str.tostring(sl, format.mintick) + (tpR > 2 ? "\nlowest 1:2 → " + str.tostring(e + d * 2 * r, format.mintick) : "") + "\ntarget 1:" + str.tostring(tpR, "#.#") + " → " + str.tostring(tp, format.mintick) + "  ✓ default" + (rrMax > tpR + 0.25 ? "\nhighest 1:" + str.tostring(rrMax, "#.#") + " → " + str.tostring(tpMax, format.mintick) + " (max 1:" + str.tostring(maxR, "#") + ")" : "") + (not na(fill) and fill < 0.3 ? "\n⚠ zone filled " + str.tostring(math.round(fill * 100)) + "% (under 30%)" : "") + (volTxt == "" ? "" : "\n" + volTxt)
                            if planWhere != "Panel"
                                sEntT := label.new(x2, e, plan, style = label.style_label_left, color = color.new(#000000, 100), textcolor = #8e44ad, size = size.normal, textalign = text.align_left)
                            // the target (1:3) and the highest target as lines with short tags, the stop and entry tagged too
                            sTpL := line.new(bar_index, tp, x2, tp, color = color.new(#26a69a, 0), style = line.style_dashed, width = 2)
                            sTpT := label.new(bar_index, tp, "TP 1:" + str.tostring(tpR, "#.#") + "  " + str.tostring(tp, format.mintick), style = d == 1 ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(#000000, 100), textcolor = #26a69a, size = size.normal)
                            sStopT := label.new(bar_index, sl, "SL " + str.tostring(sl, format.mintick), style = d == 1 ? label.style_label_upper_left : label.style_label_lower_left, color = color.new(#000000, 100), textcolor = #ef5350, size = size.normal)
                            sEntTag := label.new(x1, e, (d == 1 ? "BUY " : "SELL ") + str.tostring(e, format.mintick), style = d == 1 ? label.style_label_upper_left : label.style_label_lower_left, color = color.new(#000000, 100), textcolor = #8e44ad, size = size.normal)
                            if rrMax > tpR + 0.25
                                sMax := line.new(bar_index, tpMax, x2, tpMax, color = color.new(#26a69a, 50), style = line.style_dotted, width = 2)
                                sMaxT := label.new(bar_index, tpMax, "MAX 1:" + str.tostring(rrMax, "#.#") + "  " + str.tostring(tpMax, format.mintick), style = d == 1 ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(#000000, 100), textcolor = color.new(#26a69a, 30), size = size.small)
                        if kind == "breaker"
                            sFvg := box.new(bar_index - bbK0, bHi, x2, bLo, border_color = color.new(#5aa9e6, 20), bgcolor = color.new(#5aa9e6, 80), text = "BREAKER", text_size = size.tiny, text_color = #3b8fd6, text_halign = text.align_left)
                        else if not na(fvgK)
                            // the FVG, extended to the right: the limit sits at its edge
                            sFvg := box.new(x1, d == 1 ? low[fvgK] : low[fvgK + 2], x2, d == 1 ? high[fvgK + 2] : high[fvgK], border_color = color.new(#8e44ad, 30), bgcolor = color.new(#8e44ad, 85), text = "FVG", text_size = size.tiny, text_color = #8e44ad, text_halign = text.align_left)
                        if not na(sweepI)
                            sSw := line.new(sweepI, sweepV, extBar, sweepV, color = color.new(#9aa3ad, 0), style = line.style_dotted, width = 2)
                            sSwT := label.new(sweepI, sweepV, "$$$", style = d == 1 ? label.style_label_up : label.style_label_down, color = color.new(#000000, 100), textcolor = #9aa3ad, size = size.small)
                    if showTrade and showTradeLabel
                        sLab := label.new(bar_index + 48, e, (d == 1 ? "BUY LIMIT " : "SELL LIMIT ") + str.tostring(e, format.mintick) + " (" + kind + ")\nafter MSS 5m at " + str.tostring(swV, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + " · TP " + str.tostring(tp, format.mintick) + " (" + str.tostring(rr, "#.#") + "R)" + (na(liq) ? "" : "\n5m swing " + str.tostring(liq, format.mintick) + " (" + str.tostring(math.abs(liq - e) / r, "#.#") + "R)"), style = label.style_label_left, color = color.new(#111923, 0), textcolor = color.white, size = size.normal)
                    sMss := line.new(swI, swV, bar_index, swV, color = color.new(#e0b000, 0), width = 2)
                    sMssT := label.new(swI, swV, "CHoCH 5m", style = d == 1 ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(#000000, 100), textcolor = #e0b000, size = size.small)
                    string liqJ = na(liq) ? "null" : str.tostring(liq)
                    string liqRJ = na(liq) ? "null" : str.tostring(math.abs(liq - e) / r, "#.##")
                    string side4 = t4 == 0 ? "4H trend unclear" : t4 == d ? "with the 4H trend" : "AGAINST the 4H trend"
                    string txt = (zGo ? "✅ TAKE " : "⛔ SKIP ") + (aPlus ? "A+ " : "") + syminfo.ticker + " " + (d == 1 ? "BUY" : "SELL") + " limit " + str.tostring(e, format.mintick) + " · SL " + str.tostring(sl, format.mintick) + " · TP " + str.tostring(tp, format.mintick) + " (" + str.tostring(rr, "#.#") + "R, " + kind + ") · " + htfName + (d == 1 ? " demand " : " supply ") + str.tostring(hBot, format.mintick) + "–" + str.tostring(hTop, format.mintick) + " · 5m MSS at " + str.tostring(swV, format.mintick) + " · " + side4 + (na(liq) ? "" : " · 5m swing at " + str.tostring(math.abs(liq - e) / r, "#.#") + "R") + (rrMax > tpR + 0.25 ? " · highest target " + str.tostring(tpMax, format.mintick) + " (" + str.tostring(rrMax, "#.#") + "R)" : "") + (na(fill) ? "" : " · " + fillTxt(fill)) + (volTxt == "" ? "" : " · " + volTxt) + " · zone score " + scoreTxt(zSc) + " (" + zWhy + ")"
                    if (zGo or not onlyAPlus) and alertMode == "Edge webhook"
                        alert('{"secret":"' + secret + '","type":"setup","strategy":"sd","symbol":"' + syminfo.ticker + '","tv":"' + syminfo.tickerid + '","dir":"' + side + '","entry":' + str.tostring(e) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"rr":' + str.tostring(rr, "#.##") + ',"kind":"' + kind + '","aplus":' + (aPlus ? "true" : "false") + ',"vol":' + (na(volX) ? "null" : str.tostring(volX, "#.##")) + ',"zoneTop":' + str.tostring(hTop) + ',"zoneBot":' + str.tostring(hBot) + ',"mss":' + str.tostring(swV) + ',"liq":' + liqJ + ',"liqR":' + liqRJ + ',"trend4h":' + str.tostring(t4) + ',"tpMax":' + str.tostring(tpMax) + ',"rrMax":' + str.tostring(rrMax, "#.##") + ',"fill":' + (na(fill) ? "null" : str.tostring(fill, "#.##")) + ',"go":' + (zGo ? "true" : "false") + ',"score":' + str.tostring(zSc) + ',"scoreWhy":"' + zWhy + '","validMin":240}', alert.freq_once_per_bar_close)
                    else if zGo or not onlyAPlus
                        alert(txt, alert.freq_once_per_bar_close)

// ---------- the panel, top right: 4H trend, 1H trend, the zone and what Edge is waiting for
tc(v) => v == 1 ? color.new(#4ade80, 0) : v == -1 ? color.new(#f87171, 0) : color.gray
tt(v) => v == 1 ? "▲ Bullish" : v == -1 ? "▼ Bearish" : "— none yet"
var table panel = table.new(panelPos == "Top right" ? position.top_right : panelPos == "Bottom right" ? position.bottom_right : panelPos == "Bottom left" ? position.bottom_left : position.top_left, 2, 16, bgcolor = color.new(#111923, 10), border_width = 0, frame_color = color.new(#334155, 0), frame_width = 1)
if showPanel and barstate.islast
    pS = panelSize == "Small" ? size.small : panelSize == "Large" ? size.large : size.normal
    string zTxt = hDir == 0 ? "no valid zone" : (hDir == 1 ? "Demand " : "Supply ") + str.tostring(hBot, format.mintick) + "–" + str.tostring(hTop, format.mintick)
    string st = hDir == 0 ? (hCnt < 2 ? "Wait: 1H needs a 2nd BOS" : "Wait: no fresh 1H zone") : hId == usedId ? "Zone used — wait for the next" : armId == hId ? "IN ZONE · " + (nz(fillOf(ext)) > 1 ? "past the far edge" : "filled " + str.tostring(math.round(nz(fillOf(ext)) * 100)) + "%") + (stagnant ? " — price RANGING: no trade until it moves" : " — waiting for 5m MSS") : "Wait: price not in the zone yet"
    string wTxt = hDir == 0 or t4 == 0 ? "" : hDir == t4 ? "  (with 4H)" : "  (against 4H)"
    table.cell(panel, 0, 0, "4H trend", text_color = color.gray, text_size = pS, text_halign = text.align_left)
    table.cell(panel, 1, 0, tt(t4), text_color = tc(t4), text_size = pS, text_halign = text.align_left)
    table.cell(panel, 0, 1, htfName + " trend", text_color = color.gray, text_size = pS, text_halign = text.align_left)
    table.cell(panel, 1, 1, tt(hTrend) + (hCnt >= 2 ? " · " + str.tostring(hCnt) + " BOS" : " · 1 break"), text_color = tc(hTrend), text_size = pS, text_halign = text.align_left)
    table.cell(panel, 0, 2, htfName + " zone", text_color = color.gray, text_size = pS, text_halign = text.align_left)
    table.cell(panel, 1, 2, zTxt + wTxt, text_color = hDir == 1 ? #5aa9e6 : hDir == -1 ? #f08a4b : color.gray, text_size = pS, text_halign = text.align_left)
    if timeframe.period != "5"
        st := "Put this on a 5-MINUTE chart"
    string z4Txt = x4Dir == 0 ? "no valid zone" : (x4Dir == 1 ? "Demand " : "Supply ") + str.tostring(x4Bot, format.mintick) + "–" + str.tostring(x4Top, format.mintick)
    table.cell(panel, 0, 3, "4H zone", text_color = color.gray, text_size = pS, text_halign = text.align_left)
    table.cell(panel, 1, 3, z4Txt, text_color = x4Dir == 1 ? #26a69a : x4Dir == -1 ? #d64578 : color.gray, text_size = pS, text_halign = text.align_left)
    table.cell(panel, 0, 4, "Edge", text_color = color.gray, text_size = pS, text_halign = text.align_left)
    table.cell(panel, 1, 4, st, text_color = armId == hId and hDir != 0 ? color.new(#f0c94b, 0) : color.white, text_size = pS, text_halign = text.align_left)
    table.cell(panel, 0, 5, "Orders", text_color = color.gray, text_size = pS, text_halign = text.align_left)
    table.cell(panel, 1, 5, inWin ? "open (03:00–11:00 NY)" : "closed (03:00–11:00 NY)", text_color = inWin ? color.new(#4ade80, 0) : color.gray, text_size = pS, text_halign = text.align_left)
    // the latest setup's plan, readable on a phone (Chart → Trade plan text)
    if planWhere != "On the chart" and pSide != "" and time - pTime < 8 * 3600000
        table.cell(panel, 0, 6, "SETUP", text_color = color.new(#c084fc, 0), text_size = pS, text_halign = text.align_left)
        table.cell(panel, 1, 6, pSide, text_color = str.startswith(pSide, "✅") ? color.new(#4ade80, 0) : str.startswith(pSide, "⛔") ? color.new(#f87171, 0) : color.new(#c084fc, 0), text_size = pS, text_halign = text.align_left)
        table.cell(panel, 0, 7, "Stop", text_color = color.gray, text_size = pS, text_halign = text.align_left)
        table.cell(panel, 1, 7, pStop, text_color = color.new(#f87171, 0), text_size = pS, text_halign = text.align_left)
        table.cell(panel, 0, 8, "Lowest", text_color = color.gray, text_size = pS, text_halign = text.align_left)
        table.cell(panel, 1, 8, pLow, text_color = color.white, text_size = pS, text_halign = text.align_left)
        table.cell(panel, 0, 9, "Target", text_color = color.gray, text_size = pS, text_halign = text.align_left)
        table.cell(panel, 1, 9, pTgt, text_color = color.new(#4ade80, 0), text_size = pS, text_halign = text.align_left)
        table.cell(panel, 0, 10, "Highest", text_color = color.gray, text_size = pS, text_halign = text.align_left)
        table.cell(panel, 1, 10, pHigh, text_color = color.new(#4ade80, 30), text_size = pS, text_halign = text.align_left)
        table.cell(panel, 0, 12, "Score", text_color = color.gray, text_size = pS, text_halign = text.align_left)
        table.cell(panel, 1, 12, pScore, text_color = str.startswith(pScore, "+2") or str.startswith(pScore, "+3") ? color.new(#4ade80, 0) : str.startswith(pScore, "+1") ? color.new(#a3e635, 0) : color.gray, text_size = pS, text_halign = text.align_left)
        table.cell(panel, 0, 13, "With", text_color = color.gray, text_size = pS, text_halign = text.align_left)
        table.cell(panel, 1, 13, pConf, text_color = color.white, text_size = pS, text_halign = text.align_left)
        if pNote != ""
            table.cell(panel, 0, 11, "Note", text_color = color.gray, text_size = pS, text_halign = text.align_left)
            table.cell(panel, 1, 11, pNote, text_color = color.new(#f0c94b, 0), text_size = pS, text_halign = text.align_left)

// ---------------------------------------------------------------------------
// Clean add-on: 80 SMA + Volume Profile (POC / VAH / VAL) — on the chart only. Alerts, grades and
// TAKE/SKIP don't use them (Edge's tests found no edge in volume as a rule; this is context to look at).
// POC = the price with the most volume in the lookback; VAH / VAL = the top and bottom of the value area
// (the rows around the POC holding 70% of the volume).
showSMA = input.bool(true, "Show 80 SMA", group = "Clean add-on")
smaLen = input.int(80, "SMA length", minval = 1, group = "Clean add-on")
showVP = input.bool(true, "Show Volume Profile lines", group = "Clean add-on")
vpLook = input.int(150, "VP lookback bars", minval = 20, maxval = 500, group = "Clean add-on")
vpRows = input.int(40, "VP rows", minval = 10, maxval = 100, group = "Clean add-on")
vaPct = input.float(70, "Value area %", minval = 10, maxval = 100, group = "Clean add-on") / 100

sma80 = ta.sma(close, smaLen)
plot(showSMA ? sma80 : na, "80 SMA", color = color.new(color.gray, 40), linewidth = 1)

vpHi = ta.highest(high, vpLook)
vpLo = ta.lowest(low, vpLook)

var line pocL = na
var line vahL = na
var line valL = na

if showVP and barstate.islast and vpHi > vpLo
    vpStep = (vpHi - vpLo) / vpRows
    vols = array.new_float(vpRows, 0.0)
    for i = 0 to vpLook - 1
        idx = math.min(vpRows - 1, math.max(0, int((hl2[i] - vpLo) / vpStep)))
        array.set(vols, idx, array.get(vols, idx) + nz(volume[i]))
    vpTotal = array.sum(vols)
    line.delete(pocL)
    line.delete(vahL)
    line.delete(valL)
    // no volume on this symbol: no lines rather than wrong ones
    if vpTotal > 0
        pocIdx = array.indexof(vols, array.max(vols))
        vaUp = pocIdx
        vaDn = pocIdx
        acc = array.get(vols, pocIdx)
        while acc < vpTotal * vaPct and (vaUp < vpRows - 1 or vaDn > 0)
            vUp = vaUp < vpRows - 1 ? array.get(vols, vaUp + 1) : -1.0
            vDn = vaDn > 0 ? array.get(vols, vaDn - 1) : -1.0
            if vUp >= vDn
                vaUp += 1
                acc += vUp
            else
                vaDn -= 1
                acc += vDn
        poc = vpLo + vpStep * (pocIdx + 0.5)
        vah = vpLo + vpStep * (vaUp + 1)
        val = vpLo + vpStep * vaDn
        pocL := line.new(bar_index - vpLook, poc, bar_index, poc, color = color.new(color.orange, 30), style = line.style_dotted, extend = extend.right)
        vahL := line.new(bar_index - vpLook, vah, bar_index, vah, color = color.new(color.gray, 60), style = line.style_dotted, extend = extend.right)
        valL := line.new(bar_index - vpLook, val, bar_index, val, color = color.new(color.gray, 60), style = line.style_dotted, extend = extend.right)
