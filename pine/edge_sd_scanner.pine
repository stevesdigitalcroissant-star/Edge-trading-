// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
//
// EDGE — Supply & Demand scanner (1H zones · 5m confirmation)
// ---------------------------------------------------------------------------
// Put it on a 5-minute chart of each market you trade. One alert per chart.
//
//   1. 1H trend    : a 1H candle CLOSES past the last 1H swing = break of structure (BOS).
//                    Trade only when the last two BOS point the same way.
//   2. 1H zone     : at the latest BOS, the origin of the move: the last 1–3 opposite candles
//                    (demand = down-close candles) — from their body top to the lowest low of the move.
//                    Only the most recent zone, first return only. A 1H close through it kills it.
//   3. Return      : price touches the zone.
//   4. 5m shift    : a 5m candle closes past the last 5m swing made before the low (high).
//   5. Entry       : limit at the top of the last fair value gap of that move; if none, at the
//                    breaker / mitigation block (the candles of the broken swing).
//   6. Stop        : 2 ticks past the low of the move. Target: 1:3. The nearest 5m swing in the way
//                    is sent too (and drawn) — you decide if there is room.
//   Orders only 02:00–11:30 New York. Edge keeps the setup 4 hours and closes everything by 14:20.
//
// On the chart: the live 1H zone (blue = demand, orange = supply, named with its timeframe), every 1H
// break labelled "BOS 1H" or "MSS 1H", the 5m "MSS 5m" that triggers a setup, the long / short box
// with entry, stop and target, and a panel top right: 4H trend, 1H trend, the zone, what Edge waits for.
//
// For the Edge app, create ONE alert on this chart:
//   Condition: this script → "Any alert() function call"
//   Webhook URL: https://<your-edge-app>/api/hook
//   Message: leave as is (the script writes its own JSON)
// Only the latest things stay drawn: the live zone, the last 3 BOS and last MSS (1H), the latest setup.
// ---------------------------------------------------------------------------
//@version=6
indicator("Edge — Supply & Demand scanner (1H · 5m)", shorttitle = "Edge S&D", overlay = true, max_bars_back = 600, max_boxes_count = 200, max_lines_count = 200, max_labels_count = 200)

secret = input.string("change-me", "Edge webhook secret", group = "Edge app alerts")
alertMode = input.string("Edge webhook", "Alerts go to", options = ["Edge webhook", "TradingView app (plain text)"], group = "Edge app alerts", tooltip = "No two-factor authentication on TradingView yet? Pick the TradingView app: you get a readable notification on your phone instead of the Edge webhook.")
htf = input.timeframe("60", "Zone timeframe", group = "Rules")
tpR = input.float(3, "Target (R)", step = 0.5, group = "Rules")
fromH = input.int(2, "Orders from (New York hour)", group = "Rules")
toHM = input.int(1130, "Orders until (New York, HHMM)", group = "Rules")
showZone = input.bool(true, "Draw the 1H zone", group = "Chart")
showBos = input.bool(true, "Label 1H BOS / MSS", group = "Chart")
showPanel = input.bool(true, "Trend panel (top right)", group = "Chart")
showTrade = input.bool(false, "Draw the long / short boxes (off = you place your own)", group = "Chart")
showTradeLabel = input.bool(false, "Price label next to the trade", group = "Chart")

// ---------- the 1H side: trend (two BOS the same way) and the zone of the latest BOS
sdState() =>
    var float lastH = na
    var int lastHi = na
    var bool brokeH = true
    var float lastL = na
    var int lastLi = na
    var bool brokeL = true
    var int prevDir = 0
    var int cnt = 0
    var int zDir = 0
    var float zTop = na
    var float zBot = na
    var int zId = 0
    var float zExt = na
    var int zT = na
    var int z2Dir = 0 // the zone before it, kept while it points the same way and isn't broken
    var float z2Top = na
    var float z2Bot = na
    var int z2T = na
    var float bLvl = na
    var int bT0 = na
    var int bT1 = na
    var int bDir = 0
    var bool bCh = false
    var int bId = 0
    atr = ta.atr(14)
    ph = ta.pivothigh(high, 2, 2)
    pl = ta.pivotlow(low, 2, 2)
    if not na(ph)
        lastH := ph
        lastHi := bar_index - 2
        brokeH := false
    if not na(pl)
        lastL := pl
        lastLi := bar_index - 2
        brokeL := false
    // a close through the far side kills the zone
    if zDir == 1 and close < zBot
        zDir := 0
    if zDir == -1 and close > zTop
        zDir := 0
    if z2Dir == 1 and close < z2Bot
        z2Dir := 0
    if z2Dir == -1 and close > z2Top
        z2Dir := 0
    for d in array.from(1, -1)
        bool hit = d == 1 ? (not brokeH and not na(lastH) and close > lastH) : (not brokeL and not na(lastL) and close < lastL)
        if hit
            int sw = d == 1 ? lastHi : lastLi
            if d == 1
                brokeH := true
            else
                brokeL := true
            // the break itself, for the chart: BOS = same way as the last one, MSS = the first one the other way
            bLvl := d == 1 ? lastH : lastL
            bT0 := time[bar_index - sw]
            bT1 := time
            bDir := d
            bCh := prevDir != 0 and d != prevDir
            bId += 1
            cnt := d == prevDir ? cnt + 1 : 1
            prevDir := d
            int span = math.min(bar_index - sw, 400)
            // origin: the extreme between the broken swing and this candle
            int o = 0
            for k = 0 to span
                if d == 1 ? low[k] < low[o] : high[k] > high[o]
                    o := k
            // the last 1–3 opposite candles at the origin
            bool oppO = d == 1 ? close[o] < open[o] : close[o] > open[o]
            bool oppO1 = d == 1 ? close[o + 1] < open[o + 1] : close[o + 1] > open[o + 1]
            int a = (not oppO and oppO1) ? o + 1 : o
            int n = 0
            float near = na
            for k = a to a + 2
                bool opp = d == 1 ? close[k] < open[k] : close[k] > open[k]
                if not opp
                    break
                // an older opposite candle joins only if it sits inside the last one's range (a base), not a step of the drop
                if n > 0 and (d == 1 ? math.max(open[k], close[k]) > high[a] : math.min(open[k], close[k]) < low[a])
                    break
                n += 1
                near := d == 1 ? math.max(nz(near, -1e10), math.max(open[k], close[k])) : math.min(nz(near, 1e10), math.min(open[k], close[k]))
            int oldest = n > 0 ? a + n - 1 : o
            if n == 0
                near := d == 1 ? math.max(open[o], close[o]) : math.min(open[o], close[o])
            float far = d == 1 ? low[oldest] : high[oldest]
            for k = 0 to oldest
                far := d == 1 ? math.min(far, low[k]) : math.max(far, high[k])
            float zt = d == 1 ? near : far
            float zb = d == 1 ? far : near
            // the current zone becomes the older one if it points the same way; a break the other way clears it
            if zDir == d
                z2Dir := d
                z2Top := zTop
                z2Bot := zBot
                z2T := zT
            else if z2Dir != d
                z2Dir := 0
            if zt - zb > 0 and zt - zb <= 3 * atr
                zDir := d
                zTop := zt
                zBot := zb
                zId += 1
                zT := time[oldest]
                zExt := d == 1 ? high : low
            else
                zDir := 0
    if zDir != 0
        zExt := zDir == 1 ? math.max(zExt, high) : math.min(zExt, low)
    int ok = zDir != 0 and cnt >= 2 ? zDir : 0
    int ok2 = z2Dir != 0 and cnt >= 2 and z2Dir == prevDir ? z2Dir : 0
    [ok[1], zTop[1], zBot[1], zId[1], zT[1], bLvl[1], bT0[1], bT1[1], bDir[1], bCh[1], bId[1], prevDir[1], cnt[1], ok2[1], z2Top[1], z2Bot[1], z2T[1]]

// 4H trend: the direction of the last 4H close past a 4H swing
trendState() =>
    var float h = na
    var float l = na
    var int dir = 0
    ph = ta.pivothigh(high, 2, 2)
    pl = ta.pivotlow(low, 2, 2)
    if not na(ph)
        h := ph
    if not na(pl)
        l := pl
    if not na(h) and close > h
        dir := 1
        h := na
    if not na(l) and close < l
        dir := -1
        l := na
    dir[1]

[hDir, hTop, hBot, hId, hZT, bLvl, bT0, bT1, bDir, bCh, bId, hTrend, hCnt, h2Dir, h2Top, h2Bot, h2T] = request.security(syminfo.tickerid, htf, sdState(), lookahead = barmerge.lookahead_on)
t4 = request.security(syminfo.tickerid, "240", trendState(), lookahead = barmerge.lookahead_on)
htfName = htf == "60" ? "1H" : htf == "240" ? "4H" : htf + "m"

// ---------- the 5m side
var int usedId = -1
var box sTp = na
var box sSl = na
var label sLab = na
var line sMss = na
var line sLiq = na
var label sMssT = na
var int armId = -1
var float ext = na
var int extBar = na
var array<int> phI = array.new_int()
var array<float> phV = array.new_float()
var array<int> plI = array.new_int()
var array<float> plV = array.new_float()
p5h = ta.pivothigh(high, 2, 2)
p5l = ta.pivotlow(low, 2, 2)
if not na(p5h)
    array.push(phI, bar_index - 2)
    array.push(phV, p5h)
if not na(p5l)
    array.push(plI, bar_index - 2)
    array.push(plV, p5l)
if array.size(phI) > 300
    array.shift(phI)
    array.shift(phV)
if array.size(plI) > 300
    array.shift(plI)
    array.shift(plV)

nyH = hour(time_close, "America/New_York")
nyM = minute(time_close, "America/New_York")
hhmm = nyH * 100 + nyM
inWin = nyH >= fromH and hhmm < toHM
tick = syminfo.mintick

var box zBox = na
var label zLab = na
var box z2Box = na
var label z2Lab = na
barMs = timeframe.in_seconds() * 1000
rightX = time + 6 * barMs // labels live in the empty space right of the last candle, never on the candles
if showZone and barstate.islast
    box.delete(zBox)
    label.delete(zLab)
    box.delete(z2Box)
    label.delete(z2Lab)
    // the older zone with the trend, only while the trend holds and it isn't broken
    // the older zone only when it makes sense: same way as the trend and clear of the newest zone (no overlap)
    bool overlap = hDir != 0 and h2Bot <= hTop and h2Top >= hBot
    if h2Dir != 0 and h2Dir == hTrend and not overlap
        string z2Name = htfName + (h2Dir == 1 ? " DEMAND zone " : " SUPPLY zone ") + str.tostring(h2Bot, format.mintick) + "–" + str.tostring(h2Top, format.mintick) + " (older)"
        z2Box := box.new(nz(h2T, time - 300 * 300000), h2Top, time, h2Bot, xloc = xloc.bar_time, extend = extend.right, border_color = h2Dir == 1 ? color.new(#5aa9e6, 50) : color.new(#f08a4b, 50), bgcolor = h2Dir == 1 ? color.new(#5aa9e6, 92) : color.new(#f08a4b, 92))
        z2Lab := label.new(rightX, h2Dir == 1 ? h2Top : h2Bot, z2Name, xloc = xloc.bar_time, style = label.style_label_left, color = h2Dir == 1 ? color.new(#5aa9e6, 40) : color.new(#f08a4b, 40), textcolor = color.white, size = size.small)
    if hDir != 0
        string zName = htfName + (hDir == 1 ? " DEMAND zone " : " SUPPLY zone ") + str.tostring(hBot, format.mintick) + "–" + str.tostring(hTop, format.mintick)
        zBox := box.new(nz(hZT, time - 150 * 300000), hTop, time, hBot, xloc = xloc.bar_time, extend = extend.right, border_color = hDir == 1 ? color.new(#5aa9e6, 30) : color.new(#f08a4b, 30), bgcolor = hDir == 1 ? color.new(#5aa9e6, 85) : color.new(#f08a4b, 85))
        zLab := label.new(rightX, hDir == 1 ? hTop : hBot, zName, xloc = xloc.bar_time, style = label.style_label_left, color = hDir == 1 ? color.new(#5aa9e6, 0) : color.new(#f08a4b, 0), textcolor = color.white, size = size.normal)

// 1H breaks: only the last 3 BOS and the last MSS stay on the chart
var int lastBId = 0
var array<line> bosL = array.new<line>()
var array<label> bosT = array.new<label>()
var line chL = na
var label chT = na
if showBos and bId != lastBId and not na(bLvl) and not na(bT0)
    lastBId := bId
    color bc = bCh ? color.new(#f0c94b, 0) : (bDir == 1 ? color.new(#5aa9e6, 0) : color.new(#f08a4b, 0))
    line ln = line.new(bT0, bLvl, bT1, bLvl, xloc = xloc.bar_time, color = bc, width = 2)
    // the line runs from the swing to the candle that broke it; the name sits at its middle, on the side
    // with no candles (above a break up, below a break down)
    label lb = label.new(math.round((bT0 + bT1) / 2), bLvl, (bCh ? "MSS " : "BOS ") + htfName, xloc = xloc.bar_time, style = bDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(#000000, 100), textcolor = bc, size = size.small)
    if bCh
        line.delete(chL)
        label.delete(chT)
        chL := ln
        chT := lb
    else
        array.push(bosL, ln)
        array.push(bosT, lb)
        if array.size(bosL) > 3
            line.delete(array.shift(bosL))
            label.delete(array.shift(bosT))

if barstate.isconfirmed and hDir != 0 and hId != usedId
    d = hDir
    if armId != hId
        if d == 1 ? low <= hTop : high >= hBot
            armId := hId
            ext := d == 1 ? low : high
            extBar := bar_index
    if armId == hId
        if d == 1 ? low < ext : high > ext
            ext := d == 1 ? low : high
            extBar := bar_index
        // the last 5m swing made before the extreme
        int swI = na
        float swV = na
        ids = d == 1 ? phI : plI
        vals = d == 1 ? phV : plV
        int sz = array.size(ids)
        if sz > 0
            for j = sz - 1 to 0
                int ii = array.get(ids, j)
                if ii < extBar - 120
                    break
                if ii < extBar
                    swI := ii
                    swV := array.get(vals, j)
                    break
        if not na(swV) and (d == 1 ? close > swV : close < swV)
            usedId := hId
            armId := -1
            if inWin
                int back = bar_index - swI
                float leg = d == 1 ? low : high
                for k = 0 to back
                    leg := d == 1 ? math.min(leg, low[k]) : math.max(leg, high[k])
                float sl = leg - d * 2 * tick
                // fair value gap (the last one of the move)
                float fvg = na
                if back >= 2
                    for k = back - 2 to 0
                        if d == 1 ? low[k] > high[k + 2] : high[k] < low[k + 2]
                            fvg := d == 1 ? low[k] : high[k]
                // block: the candles of the broken swing
                int bOff = back
                float bHi = high[bOff]
                float bLo = low[bOff]
                for k = bOff to bOff + 2
                    bool same = d == 1 ? close[k] > open[k] : close[k] < open[k]
                    if not same
                        break
                    bHi := math.max(bHi, high[k])
                    bLo := math.min(bLo, low[k])
                string kind = na(fvg) ? "block" : "FVG"
                float e = na(fvg) ? (d == 1 ? bHi : bLo) : fvg
                float r = math.abs(e - sl)
                if d * (e - sl) > 0 and r >= 4 * tick
                    // target 1:3; the nearest 5m swing in the way is sent so you can judge the room
                    float tp = e + d * tpR * r
                    float liq = na
                    tids = d == 1 ? phI : plI
                    tvals = d == 1 ? phV : plV
                    int ts = array.size(tids)
                    if ts > 0
                        for j = ts - 1 to 0
                            if array.get(tids, j) < bar_index - 400
                                break
                            float v = array.get(tvals, j)
                            if d * (v - e) > 0
                                liq := na(liq) ? v : (d == 1 ? math.min(liq, v) : math.max(liq, v))
                    float rr = math.abs(tp - e) / r
                    string side = d == 1 ? "long" : "short"
                    if kind == "block"
                        float prevExt = d == 1 ? low[back + 1] : high[back + 1]
                        for k = back + 1 to back + 30
                            prevExt := d == 1 ? math.min(prevExt, low[k]) : math.max(prevExt, high[k])
                        kind := (d == 1 ? leg < prevExt : leg > prevExt) ? "breaker" : "mitigation"
                    // the long / short box at the limit — only the latest setup stays on the chart
                    box.delete(sTp)
                    box.delete(sSl)
                    label.delete(sLab)
                    line.delete(sMss)
                    line.delete(sLiq)
                    label.delete(sMssT)
                    if showTrade
                        sTp := box.new(bar_index, d == 1 ? tp : e, bar_index + 48, d == 1 ? e : tp, border_color = color.new(#4ade80, 20), bgcolor = color.new(#4ade80, 85))
                    if showTrade
                        sSl := box.new(bar_index, d == 1 ? e : sl, bar_index + 48, d == 1 ? sl : e, border_color = color.new(#f87171, 20), bgcolor = color.new(#f87171, 85))
                    if showTrade and showTradeLabel
                        sLab := label.new(bar_index + 48, e, (d == 1 ? "BUY LIMIT " : "SELL LIMIT ") + str.tostring(e, format.mintick) + " (" + kind + ")\nafter MSS 5m at " + str.tostring(swV, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + " · TP " + str.tostring(tp, format.mintick) + " (" + str.tostring(rr, "#.#") + "R)" + (na(liq) ? "" : "\n5m swing " + str.tostring(liq, format.mintick) + " (" + str.tostring(math.abs(liq - e) / r, "#.#") + "R)"), style = label.style_label_left, color = color.new(#111923, 0), textcolor = color.white, size = size.normal)
                    sMss := line.new(swI, swV, bar_index + 48, swV, color = color.white, style = line.style_dashed)
                    sMssT := label.new(bar_index + 48, swV, "MSS 5m", style = label.style_label_left, color = color.new(#000000, 100), textcolor = color.white, size = size.normal)
                    if showTrade and not na(liq)
                        sLiq := line.new(bar_index, liq, bar_index + 48, liq, color = color.new(#f0c94b, 0), style = line.style_dotted, width = 2)
                    string liqJ = na(liq) ? "null" : str.tostring(liq)
                    string liqRJ = na(liq) ? "null" : str.tostring(math.abs(liq - e) / r, "#.##")
                    string side4 = t4 == 0 ? "4H trend unclear" : t4 == d ? "with the 4H trend" : "AGAINST the 4H trend"
                    string txt = syminfo.ticker + " " + (d == 1 ? "BUY" : "SELL") + " limit " + str.tostring(e, format.mintick) + " · SL " + str.tostring(sl, format.mintick) + " · TP " + str.tostring(tp, format.mintick) + " (" + str.tostring(rr, "#.#") + "R, " + kind + ") · " + htfName + (d == 1 ? " demand " : " supply ") + str.tostring(hBot, format.mintick) + "–" + str.tostring(hTop, format.mintick) + " · 5m MSS at " + str.tostring(swV, format.mintick) + " · " + side4 + (na(liq) ? "" : " · 5m swing at " + str.tostring(math.abs(liq - e) / r, "#.#") + "R")
                    if alertMode == "Edge webhook"
                        alert('{"secret":"' + secret + '","type":"setup","strategy":"sd","symbol":"' + syminfo.ticker + '","tv":"' + syminfo.tickerid + '","dir":"' + side + '","entry":' + str.tostring(e) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"rr":' + str.tostring(rr, "#.##") + ',"kind":"' + kind + '","zoneTop":' + str.tostring(hTop) + ',"zoneBot":' + str.tostring(hBot) + ',"mss":' + str.tostring(swV) + ',"liq":' + liqJ + ',"liqR":' + liqRJ + ',"trend4h":' + str.tostring(t4) + ',"validMin":240}', alert.freq_once_per_bar_close)
                    else
                        alert(txt, alert.freq_once_per_bar_close)

// ---------- the panel, top right: 4H trend, 1H trend, the zone and what Edge is waiting for
tc(v) => v == 1 ? color.new(#4ade80, 0) : v == -1 ? color.new(#f87171, 0) : color.gray
tt(v) => v == 1 ? "▲ Bullish" : v == -1 ? "▼ Bearish" : "— none yet"
var table panel = table.new(position.top_right, 2, 5, bgcolor = color.new(#111923, 10), border_width = 0, frame_color = color.new(#334155, 0), frame_width = 1)
if showPanel and barstate.islast
    string zTxt = hDir == 0 ? "no valid zone" : (hDir == 1 ? "Demand " : "Supply ") + str.tostring(hBot, format.mintick) + "–" + str.tostring(hTop, format.mintick)
    string st = hDir == 0 ? (hCnt < 2 ? "Wait: 1H needs a 2nd BOS" : "Wait: no fresh 1H zone") : hId == usedId ? "Zone used — wait for the next" : armId == hId ? "IN ZONE — waiting for 5m MSS" : "Wait: price not in the zone yet"
    string wTxt = hDir == 0 or t4 == 0 ? "" : hDir == t4 ? "  (with 4H)" : "  (against 4H)"
    table.cell(panel, 0, 0, "4H trend", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 0, tt(t4), text_color = tc(t4), text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 0, 1, htfName + " trend", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 1, tt(hTrend) + (hCnt >= 2 ? " · " + str.tostring(hCnt) + " BOS" : " · 1 break"), text_color = tc(hTrend), text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 0, 2, htfName + " zone", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 2, zTxt + wTxt, text_color = hDir == 1 ? #5aa9e6 : hDir == -1 ? #f08a4b : color.gray, text_size = size.small, text_halign = text.align_left)
    if timeframe.period != "5"
        st := "Put this on a 5-MINUTE chart"
    table.cell(panel, 0, 3, "Edge", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 3, st, text_color = armId == hId and hDir != 0 ? color.new(#f0c94b, 0) : color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 0, 4, "Orders", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 4, inWin ? "open (02:00–11:30 NY)" : "closed (02:00–11:30 NY)", text_color = inWin ? color.new(#4ade80, 0) : color.gray, text_size = size.small, text_halign = text.align_left)
