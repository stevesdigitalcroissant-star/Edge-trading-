// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
//
// EDGE — Supply & Demand scanner (1H zones · 5m confirmation)
// ---------------------------------------------------------------------------
// Put it on a 5-minute chart of each market you trade. One alert per chart.
//
//   1. 1H trend    : a 1H candle CLOSES past the last 1H swing = break of structure (BOS).
//                    Trade only when the last two BOS point the same way.
//   2. 1H zone     : at the latest BOS, the origin of the move: the last 1–3 opposite candles
//                    (demand = down-close candles) — from their body top to the lowest low of the move.
//                    Only the most recent zone, first return only. A 1H close through it kills it.
//   3. Return      : price touches the zone.
//   4. 5m shift    : a 5m candle closes past the last 5m swing made before the low (high).
//   5. Entry       : limit at the top of the last fair value gap of that move; if none, at the
//                    breaker / mitigation block (the candles of the broken swing).
//   6. Stop        : 2 ticks past the low of the move. Target: the nearest 5m swing ≥ 1.5R away (max 6R).
//   Orders only 02:00–11:30 New York. Edge keeps the setup 4 hours and closes everything by 14:20.
//
// On the chart: the live 1H zone (blue = demand, orange = supply) and, for each setup, the
// long / short box with entry, stop and target.
//
// For the Edge app, create ONE alert on this chart:
//   Condition: this script → "Any alert() function call"
//   Webhook URL: https://<your-edge-app>/api/hook
//   Message: leave as is (the script writes its own JSON)
// ---------------------------------------------------------------------------
//@version=6
indicator("Edge — Supply & Demand scanner (1H · 5m)", shorttitle = "Edge S&D", overlay = true, max_bars_back = 600, max_boxes_count = 200, max_lines_count = 200, max_labels_count = 200)

secret = input.string("change-me", "Edge webhook secret", group = "Edge app alerts")
htf = input.timeframe("60", "Zone timeframe", group = "Rules")
minR = input.float(1.5, "Target at least (R)", step = 0.25, group = "Rules")
maxR = input.float(6, "Target at most (R)", step = 0.5, group = "Rules")
fromH = input.int(2, "Orders from (New York hour)", group = "Rules")
toHM = input.int(1130, "Orders until (New York, HHMM)", group = "Rules")
showZone = input.bool(true, "Draw the 1H zone", group = "Chart")

// ---------- the 1H side: trend (two BOS the same way) and the zone of the latest BOS
sdState() =>
    var float lastH = na
    var int lastHi = na
    var bool brokeH = true
    var float lastL = na
    var int lastLi = na
    var bool brokeL = true
    var int prevDir = 0
    var int cnt = 0
    var int zDir = 0
    var float zTop = na
    var float zBot = na
    var int zId = 0
    var float zExt = na
    atr = ta.atr(14)
    ph = ta.pivothigh(high, 2, 2)
    pl = ta.pivotlow(low, 2, 2)
    if not na(ph)
        lastH := ph
        lastHi := bar_index - 2
        brokeH := false
    if not na(pl)
        lastL := pl
        lastLi := bar_index - 2
        brokeL := false
    // a close through the far side kills the zone
    if zDir == 1 and close < zBot
        zDir := 0
    if zDir == -1 and close > zTop
        zDir := 0
    for d in array.from(1, -1)
        bool hit = d == 1 ? (not brokeH and not na(lastH) and close > lastH) : (not brokeL and not na(lastL) and close < lastL)
        if hit
            int sw = d == 1 ? lastHi : lastLi
            if d == 1
                brokeH := true
            else
                brokeL := true
            cnt := d == prevDir ? cnt + 1 : 1
            prevDir := d
            int span = math.min(bar_index - sw, 400)
            // origin: the extreme between the broken swing and this candle
            int o = 0
            for k = 0 to span
                if d == 1 ? low[k] < low[o] : high[k] > high[o]
                    o := k
            // the last 1–3 opposite candles at the origin
            bool oppO = d == 1 ? close[o] < open[o] : close[o] > open[o]
            bool oppO1 = d == 1 ? close[o + 1] < open[o + 1] : close[o + 1] > open[o + 1]
            int a = (not oppO and oppO1) ? o + 1 : o
            int n = 0
            float near = na
            for k = a to a + 2
                bool opp = d == 1 ? close[k] < open[k] : close[k] > open[k]
                if not opp
                    break
                n += 1
                near := d == 1 ? math.max(nz(near, -1e10), math.max(open[k], close[k])) : math.min(nz(near, 1e10), math.min(open[k], close[k]))
            int oldest = n > 0 ? a + n - 1 : o
            if n == 0
                near := d == 1 ? math.max(open[o], close[o]) : math.min(open[o], close[o])
            float far = d == 1 ? low[oldest] : high[oldest]
            for k = 0 to oldest
                far := d == 1 ? math.min(far, low[k]) : math.max(far, high[k])
            float zt = d == 1 ? near : far
            float zb = d == 1 ? far : near
            if zt - zb > 0 and zt - zb <= 3 * atr
                zDir := d
                zTop := zt
                zBot := zb
                zId += 1
                zExt := d == 1 ? high : low
            else
                zDir := 0
    if zDir != 0
        zExt := zDir == 1 ? math.max(zExt, high) : math.min(zExt, low)
    int ok = zDir != 0 and cnt >= 2 ? zDir : 0
    [ok[1], zTop[1], zBot[1], zId[1]]

[hDir, hTop, hBot, hId] = request.security(syminfo.tickerid, htf, sdState(), lookahead = barmerge.lookahead_on)

// ---------- the 5m side
var int usedId = -1
var int armId = -1
var float ext = na
var int extBar = na
var array<int> phI = array.new_int()
var array<float> phV = array.new_float()
var array<int> plI = array.new_int()
var array<float> plV = array.new_float()
p5h = ta.pivothigh(high, 2, 2)
p5l = ta.pivotlow(low, 2, 2)
if not na(p5h)
    array.push(phI, bar_index - 2)
    array.push(phV, p5h)
if not na(p5l)
    array.push(plI, bar_index - 2)
    array.push(plV, p5l)
if array.size(phI) > 300
    array.shift(phI)
    array.shift(phV)
if array.size(plI) > 300
    array.shift(plI)
    array.shift(plV)

nyH = hour(time_close, "America/New_York")
nyM = minute(time_close, "America/New_York")
hhmm = nyH * 100 + nyM
inWin = nyH >= fromH and hhmm < toHM
tick = syminfo.mintick

var box zBox = na
if showZone and barstate.islast
    box.delete(zBox)
    if hDir != 0
        zBox := box.new(bar_index - 150, hTop, bar_index + 20, hBot, border_color = hDir == 1 ? color.new(#5aa9e6, 30) : color.new(#f08a4b, 30), bgcolor = hDir == 1 ? color.new(#5aa9e6, 85) : color.new(#f08a4b, 85), text = "1H " + (hDir == 1 ? "demand" : "supply"), text_color = hDir == 1 ? #5aa9e6 : #f08a4b, text_size = size.small, text_halign = text.align_left, text_valign = text.align_top)

if barstate.isconfirmed and hDir != 0 and hId != usedId
    d = hDir
    if armId != hId
        if d == 1 ? low <= hTop : high >= hBot
            armId := hId
            ext := d == 1 ? low : high
            extBar := bar_index
    if armId == hId
        if d == 1 ? low < ext : high > ext
            ext := d == 1 ? low : high
            extBar := bar_index
        // the last 5m swing made before the extreme
        int swI = na
        float swV = na
        ids = d == 1 ? phI : plI
        vals = d == 1 ? phV : plV
        int sz = array.size(ids)
        if sz > 0
            for j = sz - 1 to 0
                int ii = array.get(ids, j)
                if ii < extBar - 120
                    break
                if ii < extBar
                    swI := ii
                    swV := array.get(vals, j)
                    break
        if not na(swV) and (d == 1 ? close > swV : close < swV)
            usedId := hId
            armId := -1
            if inWin
                int back = bar_index - swI
                float leg = d == 1 ? low : high
                for k = 0 to back
                    leg := d == 1 ? math.min(leg, low[k]) : math.max(leg, high[k])
                float sl = leg - d * 2 * tick
                // fair value gap (the last one of the move)
                float fvg = na
                if back >= 2
                    for k = back - 2 to 0
                        if d == 1 ? low[k] > high[k + 2] : high[k] < low[k + 2]
                            fvg := d == 1 ? low[k] : high[k]
                // block: the candles of the broken swing
                int bOff = back
                float bHi = high[bOff]
                float bLo = low[bOff]
                for k = bOff to bOff + 2
                    bool same = d == 1 ? close[k] > open[k] : close[k] < open[k]
                    if not same
                        break
                    bHi := math.max(bHi, high[k])
                    bLo := math.min(bLo, low[k])
                string kind = na(fvg) ? "block" : "FVG"
                float e = na(fvg) ? (d == 1 ? bHi : bLo) : fvg
                float r = math.abs(e - sl)
                if d * (e - sl) > 0 and r >= 4 * tick
                    // target: the nearest 5m swing at least minR away
                    float tp = na
                    tids = d == 1 ? phI : plI
                    tvals = d == 1 ? phV : plV
                    int ts = array.size(tids)
                    if ts > 0
                        for j = ts - 1 to 0
                            if array.get(tids, j) < bar_index - 400
                                break
                            float v = array.get(tvals, j)
                            if d * (v - e) >= minR * r
                                tp := na(tp) ? v : (d == 1 ? math.min(tp, v) : math.max(tp, v))
                    if not na(tp)
                        tp := d == 1 ? math.min(tp, e + maxR * r) : math.max(tp, e - maxR * r)
                        float rr = math.abs(tp - e) / r
                        string side = d == 1 ? "long" : "short"
                        if kind == "block"
                            float prevExt = d == 1 ? low[back + 1] : high[back + 1]
                            for k = back + 1 to back + 30
                                prevExt := d == 1 ? math.min(prevExt, low[k]) : math.max(prevExt, high[k])
                            kind := (d == 1 ? leg < prevExt : leg > prevExt) ? "breaker" : "mitigation"
                        // the long / short box on the chart
                        box.new(bar_index, d == 1 ? tp : e, bar_index + 48, d == 1 ? e : tp, border_color = color.new(#4ade80, 20), bgcolor = color.new(#4ade80, 85))
                        box.new(bar_index, d == 1 ? e : sl, bar_index + 48, d == 1 ? sl : e, border_color = color.new(#f87171, 20), bgcolor = color.new(#f87171, 85))
                        label.new(bar_index, e, (d == 1 ? "BUY " : "SELL ") + kind + " " + str.tostring(e, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + " · TP " + str.tostring(tp, format.mintick) + " (" + str.tostring(rr, "#.#") + "R)", style = label.style_label_left, color = color.new(#111923, 0), textcolor = color.white, size = size.small)
                        line.new(swI, swV, bar_index, swV, color = color.white, style = line.style_dashed)
                        alert('{"secret":"' + secret + '","type":"setup","strategy":"sd","symbol":"' + syminfo.ticker + '","tv":"' + syminfo.tickerid + '","dir":"' + side + '","entry":' + str.tostring(e) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"rr":' + str.tostring(rr, "#.##") + ',"kind":"' + kind + '","zoneTop":' + str.tostring(hTop) + ',"zoneBot":' + str.tostring(hBot) + ',"mss":' + str.tostring(swV) + ',"validMin":240}', alert.freq_once_per_bar_close)
