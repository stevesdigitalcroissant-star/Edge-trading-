// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
//
// EDGE — Trend 4H · 15m
// ---------------------------------------------------------------------------
// One small panel in the corner of any chart (any market, any timeframe):
//
//   4H   ▲ Up / ▼ Down
//   15m  ▲ Up / ▼ Down
//   → Buys only  /  Sells only  /  Wait
//
// Trend = structure on candle BODIES, the same rule as the Edge app:
//   a body swing high/low = a body higher/lower than the 2 bodies each side;
//   the trend turns UP when a body closes above the last swing high,
//   DOWN when a body closes below the last swing low, and stays until the other happens.
// Only closed candles count (no repainting).
//
// When the 4H and the 15m disagree, the panel shows the price where the 15m would
// turn back with the 4H ("Buys when a 15m body closes above …").
//
// Alerts (optional): add an alert on this script → "Trend: buys only" / "Trend: sells only"
// to hear when both timeframes line up.
// ---------------------------------------------------------------------------
//@version=6
indicator("Edge — Trend 4H · 15m", shorttitle = "Edge trend", overlay = true)

where = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left"])
big = input.string("240", "Higher timeframe", options = ["240", "60", "D"])
small = input.string("15", "Lower timeframe", options = ["15", "5", "60"])
showLevel = input.bool(true, "Draw the 15m flip level on the chart")

f_trend() =>
    top = math.max(open, close)
    bot = math.min(open, close)
    ph = ta.pivothigh(top, 2, 2)
    pl = ta.pivotlow(bot, 2, 2)
    var float hi = na
    var float lo = na
    var int dir = 0
    if not na(ph)
        hi := ph
    if not na(pl)
        lo := pl
    if not na(hi) and close > hi
        dir := 1
    else if not na(lo) and close < lo
        dir := -1
    [dir[1], hi[1], lo[1]]

// closed candles only: the last finished candle's value, seen as soon as it is final (lookahead on + [1] = no repaint)
[dB, hB, lB] = request.security(syminfo.tickerid, big, f_trend(), lookahead = barmerge.lookahead_on)
[dS, hS, lS] = request.security(syminfo.tickerid, small, f_trend(), lookahead = barmerge.lookahead_on)

tfName(tf) => tf == "240" ? "4H" : tf == "60" ? "1H" : tf == "D" ? "D" : tf + "m"
arrow(d) => d > 0 ? "▲ Up" : d < 0 ? "▼ Down" : "– None"
col(d) => d > 0 ? color.new(#26a69a, 0) : d < 0 ? color.new(#ef5350, 0) : color.new(#8a94a6, 0)

verdict = dB == 0 ? "No " + tfName(big) + " trend · sit out" : dS == dB ? (dB > 0 ? "Buys only" : "Sells only") : (dB > 0 ? "Wait · " + tfName(small) + " pulling back" : "Wait · " + tfName(small) + " bouncing")
flip = dB > 0 and dS != dB ? hS : dB < 0 and dS != dB ? lS : na
hint = na(flip) ? "" : (dB > 0 ? "Buys when a " + tfName(small) + " body closes above " : "Sells when a " + tfName(small) + " body closes below ") + str.tostring(flip, format.mintick)
vCol = dB != 0 and dS == dB ? col(dB) : color.new(#8a94a6, 0)

pos = where == "Top right" ? position.top_right : where == "Top left" ? position.top_left : where == "Bottom right" ? position.bottom_right : position.bottom_left
var table t = table.new(pos, 2, 4, bgcolor = color.new(#0e151d, 15), border_width = 0, frame_color = color.new(#2a3646, 0), frame_width = 1)
if barstate.islast
    table.cell(t, 0, 0, tfName(big), text_color = color.new(#a9b6c4, 0), text_size = size.small)
    table.cell(t, 1, 0, arrow(dB), text_color = col(dB), text_size = size.normal)
    table.cell(t, 0, 1, tfName(small), text_color = color.new(#a9b6c4, 0), text_size = size.small)
    table.cell(t, 1, 1, arrow(dS), text_color = col(dS), text_size = size.normal)
    table.cell(t, 0, 2, verdict, text_color = vCol, text_size = size.normal)
    table.merge_cells(t, 0, 2, 1, 2)
    table.cell(t, 0, 3, hint, text_color = color.new(#a9b6c4, 0), text_size = size.small)
    table.merge_cells(t, 0, 3, 1, 3)

var line lv = na
if showLevel and barstate.islast
    line.delete(lv)
    if not na(flip)
        lv := line.new(bar_index - 30, flip, bar_index + 10, flip, color = color.new(#f08a4b, 0), style = line.style_dashed, width = 1)

buyOnly = dB > 0 and dS > 0
sellOnly = dB < 0 and dS < 0
alertcondition(buyOnly and not buyOnly[1], "Trend: buys only", "{{ticker}}: 4H and 15m both UP — buys only")
alertcondition(sellOnly and not sellOnly[1], "Trend: sells only", "{{ticker}}: 4H and 15m both DOWN — sells only")
