// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
//
// EDGE — Supply & Demand, 4H trend · 15m confirmation · 5m entry
// ---------------------------------------------------------------------------
// Put it on a 5-minute chart of Gold, Crude oil or Natural gas.
//
//   1. 4H  : trend from break of structure (a CLOSE beyond the last swing).
//            The candle the move started from becomes the demand (uptrend)
//            or supply (downtrend) zone.
//   2. 4H  : wait for price to come back into a zone (the last 5 each side are tracked).
//            Liquidity taken (stops swept, then reclaimed) = A+ on any visit;
//            no sweep = A, and only on the first visit.
//   3. 15m : wait for a break of structure in the trend's direction (closed candle).
//   4. 5m  : enter on the close of the 5m candle that breaks structure again
//            (or the first 5m close after the 15m break — see settings).
//   Stop   : beyond the 5m swing the entry broke from (+ small buffer).
//   Exits  : stop to break-even at +2R, full exit at +3.2R, out of everything at 16:40 New York.
//
// It is a strategy, so the Strategy Tester shows how these exact rules did on
// past data. For the Edge app, create ONE alert on this chart:
//   Condition: this script → "alert() function calls only"
//   Webhook URL: https://<your-edge-app>/api/hook
//   Message: leave as is (the script writes its own JSON)
// ---------------------------------------------------------------------------
//@version=6
strategy("Edge — Supply & Demand (4H · 15m · 5m)", shorttitle = "Edge S&D", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1,
     pyramiding = 0, process_orders_on_close = true, commission_type = strategy.commission.percent,
     commission_value = 0.0, slippage = 2, max_boxes_count = 50, max_lines_count = 300, max_labels_count = 300)

// ---------- Settings
grpS = "Strategy"
htfTf      = input.timeframe("240", "Trend & zones timeframe", group = grpS)
mtfTf      = input.timeframe("15", "Confirmation timeframe", group = grpS)
htfLen     = input.int(3, "4H swing size (candles each side)", minval = 1, group = grpS)
mtfLen     = input.int(2, "15m swing size", minval = 1, group = grpS)
ltfLen     = input.int(2, "5m swing size", minval = 1, group = grpS)
entryMode  = input.string("5m break of structure", "5m entry trigger", options = ["5m break of structure", "First 5m close after 15m BOS"], group = grpS)
maxWait    = input.int(96, "Max 5m candles from zone touch to entry (96 = 8 hours)", minval = 6, group = grpS)
zonesMax   = input.int(5, "4H zones tracked each side", minval = 1, maxval = 10, group = grpS)
zoneCap    = input.float(1.5, "Max zone height (× 4H ATR)", minval = 0.2, step = 0.1, group = grpS)

grpR = "Risk & exits"
beR        = input.float(2.0, "Move stop to break-even at (R)", minval = 0.5, step = 0.1, group = grpR)
tpR        = input.float(3.2, "Take profit at (R)", minval = 1.0, step = 0.1, group = grpR)
beOffR     = input.float(0.05, "Break-even buffer (R)", minval = 0.0, step = 0.01, group = grpR)
stopMode   = input.string("Beyond the 5m swing", "Stop loss", options = ["Beyond the 5m swing", "Beyond the 4H zone", "Beyond the low/high since the touch"], group = grpR)
slBufAtr   = input.float(0.2, "Stop buffer (× 5m ATR)", minval = 0.0, step = 0.05, group = grpR)
minStopAtr = input.float(0.5, "Smallest normal stop (× 5m ATR)", minval = 0.0, step = 0.1, group = grpR)
maxStopAtr = input.float(6.0, "Largest normal stop (× 5m ATR)", minval = 0.5, step = 0.5, group = grpR)
riskPct    = input.float(1.0, "Backtest: risk per trade (% of equity)", minval = 0.1, maxval = 5, step = 0.1, group = grpR)

grpF = "Filters (backtest)"
useSess    = input.bool(true, "Only trade inside the session", group = grpF)
sess       = input.session("0300-1200", "Session (New York time) — gold 0300-1200, oil & gas 0800-1430", group = grpF)
aPlusOnly  = input.bool(true, "Backtest: A+ only (A = first visit without a liquidity sweep)", group = grpF)
flatSess   = input.session("1640-1800", "Close-out (New York time) — out of every trade", group = grpF)
asiaSess   = input.session("1800-0200", "Asian session (New York time) — its high/low is liquidity", group = grpF)

grpC = "Colours (one per timeframe)"
c4h = input.color(#9b5de5, "4H — zones & break of structure", group = grpC)
c15 = input.color(#2f80ed, "15m — break of structure", group = grpC)
c5  = input.color(#f2c94c, "5m — entry break of structure", group = grpC)

grpA = "Edge app alerts"
secret     = input.string("change-me", "Webhook secret (same as EDGE_HOOK_SECRET)", group = grpA)
sendBars   = input.bool(true, "Send a price heartbeat every candle (lets Edge manage your stop)", group = grpA)

// ---------- Market structure
// Returns (shifted by `off` bars so higher-timeframe values never repaint):
// trend (1 up / -1 down / 0), demand zone, supply zone, time of last BOS up / down,
// and for the last BOS each way: the level that was broken and when that swing formed.
structure(int len, float cap, int off) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    float atr = ta.atr(14)
    var float swingHigh = na
    var float swingLow = na
    var float phHigh = na
    var float phBodyBot = na
    var float plLow = na
    var float plBodyTop = na
    var int trend = 0
    var float demTop = na
    var float demBot = na
    var float supTop = na
    var float supBot = na
    var int upT = 0
    var int dnT = 0
    var int phT = 0
    var int plT = 0
    var float upLvl = na
    var float dnLvl = na
    var int upFrom = 0
    var int dnFrom = 0
    if not na(ph)
        swingHigh := ph
        phT := time[len]
        phHigh := high[len]
        phBodyBot := math.min(open[len], close[len])
    if not na(pl)
        swingLow := pl
        plT := time[len]
        plLow := low[len]
        plBodyTop := math.max(open[len], close[len])
    if not na(swingHigh) and close > swingHigh
        trend := 1
        upT := time
        upLvl := swingHigh
        upFrom := phT
        swingHigh := na
        if not na(plLow)
            demBot := plLow
            demTop := math.max(math.min(plBodyTop, plLow + atr * cap), plLow + atr * 0.25)
    if not na(swingLow) and close < swingLow
        trend := -1
        dnT := time
        dnLvl := swingLow
        dnFrom := plT
        swingLow := na
        if not na(phHigh)
            supTop := phHigh
            supBot := math.min(math.max(phBodyBot, phHigh - atr * cap), phHigh - atr * 0.25)
    [trend[off], demTop[off], demBot[off], supTop[off], supBot[off], upT[off], dnT[off], upLvl[off], upFrom[off], dnLvl[off], dnFrom[off], phHigh[off], plLow[off]]

[hTrend, hDemTop, hDemBot, hSupTop, hSupBot, hUpT, hDnT, hUpLvl, hUpFrom, hDnLvl, hDnFrom, hPH, hPL] = request.security(syminfo.tickerid, htfTf, structure(htfLen, zoneCap, 1), lookahead = barmerge.lookahead_on)
[mTrend, mDemTop, mDemBot, mSupTop, mSupBot, mUpT, mDnT, mUpLvl, mUpFrom, mDnLvl, mDnFrom, mPH, mPL] = request.security(syminfo.tickerid, mtfTf, structure(mtfLen, zoneCap, 1), lookahead = barmerge.lookahead_on)
[lTrend, lDemTop, lDemBot, lSupTop, lSupBot, lUpT, lDnT, lUpLvl, lUpFrom, lDnLvl, lDnFrom, lPH, lPL] = structure(ltfLen, zoneCap, 0)

bool newHtfDem = hUpT != hUpT[1] and not na(hDemTop)
bool newHtfSup = hDnT != hDnT[1] and not na(hSupTop)
bool mtfBosUp = mUpT != mUpT[1] and mUpT != 0
bool mtfBosDn = mDnT != mDnT[1] and mDnT != 0
bool ltfBosUp = lUpT != lUpT[1] and lUpT != 0
bool ltfBosDn = lDnT != lDnT[1] and lDnT != 0
float atr5 = ta.atr(14)
bool inSess = not useSess or not na(time(timeframe.period, sess, "America/New_York"))

// ---------- Liquidity: where stops sit — previous day high/low, Asian session high/low, 15m swing high/low
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
bool inAsia = not na(time(timeframe.period, asiaSess, "America/New_York"))
var float aHi = na
var float aLo = na
var float asiaHi = na
var float asiaLo = na
if inAsia and not inAsia[1]
    aHi := high
    aLo := low
else if inAsia
    aHi := math.max(aHi, high)
    aLo := math.min(aLo, low)
if not inAsia and inAsia[1]
    asiaHi := aHi
    asiaLo := aLo

// ---------- Zones: the last few 4H demand / supply zones, tracked on this chart
// A visit = price enters the zone after having really left it (wicks in and out are one visit).
type Zone
    float top
    float bot
    int touches = 0
    bool valid = true
    bool wasIn = false
    bool away = true
    box bx = na

var array<Zone> dems = array.new<Zone>()
var array<Zone> sups = array.new<Zone>()

addZone(array<Zone> list, float top, float bot, bool isDem) =>
    box bx = box.new(bar_index, top, bar_index + 1, bot, border_color = color.new(c4h, 30), bgcolor = color.new(c4h, isDem ? 82 : 90), extend = extend.right, text = isDem ? "4H DEMAND · fresh" : "4H SUPPLY · fresh", text_color = color.new(c4h, 0), text_size = size.small, text_halign = text.align_left, force_overlay = true)
    list.push(Zone.new(top, bot, 0, true, false, true, bx))
    if list.size() > zonesMax
        Zone old = list.shift()
        box.delete(old.bx)

// returns the zone first entered on this candle (newest first), and kills zones price closed through
visitZones(array<Zone> list, bool isDem) =>
    Zone hit = na
    int n = list.size()
    if n > 0
        for k = n - 1 to 0
            Zone z = list.get(k)
            if z.valid
                float h = z.top - z.bot
                if isDem ? low > z.top + h : high < z.bot - h
                    z.away := true
                bool inZ = low <= z.top and high >= z.bot
                if inZ and not z.wasIn and z.away
                    z.touches := z.touches + 1
                    z.away := false
                    box.set_text(z.bx, (isDem ? "4H DEMAND · visit " : "4H SUPPLY · visit ") + str.tostring(z.touches))
                    if na(hit)
                        hit := z
                z.wasIn := inZ
                if isDem ? close < z.bot : close > z.top
                    z.valid := false
                    box.set_bgcolor(z.bx, color.new(color.gray, 90))
                    box.set_extend(z.bx, extend.none)
                    box.set_right(z.bx, bar_index)
    hit

if newHtfDem
    addZone(dems, hDemTop, hDemBot, true)
if newHtfSup
    addZone(sups, hSupTop, hSupBot, false)
Zone dHit = visitZones(dems, true)
Zone sHit = visitZones(sups, false)
bool dTouchNow = not na(dHit)
bool sTouchNow = not na(sHit)

// the nearest opposing zone limits the room to the target
nearestAbove(array<Zone> list) =>
    float best = na
    for z in list
        if z.valid and z.bot > close and (na(best) or z.bot < best)
            best := z.bot
    best
nearestBelow(array<Zone> list) =>
    float best = na
    for z in list
        if z.valid and z.top < close and (na(best) or z.top > best)
            best := z.top
    best
float supAbove = nearestAbove(sups)
float demBelow = nearestBelow(dems)

// ---------- Break of structure lines: only the latest per timeframe, so the chart stays clean
var line bos4 = na
var label bos4L = na
var line bos15 = na
var label bos15L = na
var line bos5 = na
var label bos5L = na
drawBos(line old, label oldL, int fromT, int toT, float lvl, color c, string txt, int w, string st) =>
    line.delete(old)
    label.delete(oldL)
    line ln = line.new(fromT, lvl, toT, lvl, xloc = xloc.bar_time, color = c, width = w, style = st, force_overlay = true)
    label lb = label.new(toT, lvl, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 15), textcolor = color.white, size = size.tiny, force_overlay = true)
    [ln, lb]
if hUpT != hUpT[1] and not na(hUpLvl)
    [a, b] = drawBos(bos4, bos4L, hUpFrom, hUpT, hUpLvl, c4h, "4H BOS ↑ trend up", 3, line.style_solid)
    bos4 := a
    bos4L := b
if hDnT != hDnT[1] and not na(hDnLvl)
    [a, b] = drawBos(bos4, bos4L, hDnFrom, hDnT, hDnLvl, c4h, "4H BOS ↓ trend down", 3, line.style_solid)
    bos4 := a
    bos4L := b
if mtfBosUp and not na(mUpLvl)
    [a, b] = drawBos(bos15, bos15L, mUpFrom, mUpT, mUpLvl, c15, "15m BOS ↑", 2, line.style_dashed)
    bos15 := a
    bos15L := b
if mtfBosDn and not na(mDnLvl)
    [a, b] = drawBos(bos15, bos15L, mDnFrom, mDnT, mDnLvl, c15, "15m BOS ↓", 2, line.style_dashed)
    bos15 := a
    bos15L := b
if ltfBosUp and not na(lUpLvl)
    [a, b] = drawBos(bos5, bos5L, lUpFrom, lUpT, lUpLvl, c5, "5m BOS ↑", 1, line.style_dotted)
    bos5 := a
    bos5L := b
if ltfBosDn and not na(lDnLvl)
    [a, b] = drawBos(bos5, bos5L, lDnFrom, lDnT, lDnLvl, c5, "5m BOS ↓", 1, line.style_dotted)
    bos5 := a
    bos5L := b

// ---------- Setup state machines (0 idle → 1 zone touched → 2 15m confirmed)
var int lState = 0
var int lBar = 0
var float lLow = na
var int lTouch = 0
var float lLiq15 = na
var Zone lZone = na
var int sState = 0
var int sBar = 0
var float sHigh = na
var int sTouch = 0
var float sLiq15 = na
var Zone sZone = na
float lZoneTop = na
float lZoneBot = na
float sZoneTop = na
float sZoneBot = na
if not na(lZone)
    lZoneTop := lZone.top
    lZoneBot := lZone.bot
if not na(sZone)
    sZoneTop := sZone.top
    sZoneBot := sZone.bot

bool trigger5 = entryMode == "First 5m close after 15m BOS"
bool longSig = lState == 2 and (trigger5 ? close > open : ltfBosUp) and barstate.isconfirmed
bool shortSig = sState == 2 and (trigger5 ? close < open : ltfBosDn) and barstate.isconfirmed

// trade plan for a signal on this candle
// stop: beyond the 5m swing the entry broke from (default), the far edge of the zone, or the extreme since the touch
float lBase = stopMode == "Beyond the 4H zone" and not na(lZoneBot) ? math.min(lZoneBot, low) : stopMode == "Beyond the 5m swing" and not na(lPL) and lPL < close ? math.min(lPL, low) : math.min(lLow, low)
float lSL = lBase - slBufAtr * atr5
float lRisk = close - lSL
float lRoom = not na(supAbove) and lRisk > 0 ? (supAbove - close) / lRisk : na
bool lFresh = lTouch == 1
bool lRoomOk = na(lRoom) or lRoom >= tpR
bool lStopOk = lRisk > 0 and lRisk / atr5 >= minStopAtr and lRisk / atr5 <= maxStopAtr
float sBase = stopMode == "Beyond the 4H zone" and not na(sZoneTop) ? math.max(sZoneTop, high) : stopMode == "Beyond the 5m swing" and not na(lPH) and lPH > close ? math.max(lPH, high) : math.max(sHigh, high)
float sSL = sBase + slBufAtr * atr5
float sRisk = sSL - close
float sRoom = not na(demBelow) and sRisk > 0 ? (close - demBelow) / sRisk : na
bool sFresh = sTouch == 1
bool sRoomOk = na(sRoom) or sRoom >= tpR
bool sStopOk = sRisk > 0 and sRisk / atr5 >= minStopAtr and sRisk / atr5 <= maxStopAtr

// liquidity taken? price traded beyond a level where stops sit, and is now back on the right side of it
sweepLong(float lowest) =>
    string nm = ""
    float lv = na
    if not na(pdl) and lowest < pdl and close > pdl
        nm := "previous day low"
        lv := pdl
    else if not na(asiaLo) and lowest < asiaLo and close > asiaLo
        nm := "Asian low"
        lv := asiaLo
    else if not na(lLiq15) and lowest < lLiq15 and close > lLiq15
        nm := "15m swing low"
        lv := lLiq15
    [nm, lv]
sweepShort(float highest) =>
    string nm = ""
    float lv = na
    if not na(pdh) and highest > pdh and close < pdh
        nm := "previous day high"
        lv := pdh
    else if not na(asiaHi) and highest > asiaHi and close < asiaHi
        nm := "Asian high"
        lv := asiaHi
    else if not na(sLiq15) and highest > sLiq15 and close < sLiq15
        nm := "15m swing high"
        lv := sLiq15
    [nm, lv]
[lSwName, lSwLvl] = sweepLong(math.min(lLow, low))
[sSwName, sSwLvl] = sweepShort(math.max(sHigh, high))
bool lSwept = lSwName != ""
bool sSwept = sSwName != ""

// state transitions (after the signal check, so tap → 15m → 5m happen in order)
if lState > 0
    lLow := math.min(lLow, low)
    if hTrend != 1 or not lZone.valid or bar_index - lBar > maxWait or longSig
        lState := 0
if lState == 1 and mtfBosUp
    lState := 2
if lState == 0 and hTrend == 1 and dTouchNow and not longSig
    lState := 1
    lBar := bar_index
    lLow := low
    lTouch := dHit.touches
    lLiq15 := mPL
    lZone := dHit

if sState > 0
    sHigh := math.max(sHigh, high)
    if hTrend != -1 or not sZone.valid or bar_index - sBar > maxWait or shortSig
        sState := 0
if sState == 1 and mtfBosDn
    sState := 2
if sState == 0 and hTrend == -1 and sTouchNow and not shortSig
    sState := 1
    sBar := bar_index
    sHigh := high
    sTouch := sHit.touches
    sLiq15 := mPH
    sZone := sHit

// ---------- Alerts for the Edge app
f(float x) => str.tostring(x, "#.#####")
b(bool x) => x ? "true" : "false"

setupJson(string dir, float entry, float sl, bool fresh, float room, bool stopOk, float zTop, float zBot, float l4, float l15, float l5, float opp, string swName, float swLvl) =>
    float risk = math.abs(entry - sl)
    float tp = dir == "long" ? entry + tpR * risk : entry - tpR * risk
    '{"secret":"' + secret + '","type":"setup","symbol":"' + syminfo.ticker + '","tv":"' + syminfo.tickerid + '","dir":"' + dir +
     '","entry":' + f(entry) + ',"sl":' + f(sl) + ',"tp":' + f(tp) + ',"trend4h":' + str.tostring(hTrend) +
     ',"zoneFresh":' + b(fresh) + ',"bos15":true,"close5":true,"stopOk":' + b(stopOk) +
     ',"roomR":' + (na(room) ? "null" : f(room)) + ',"zoneTop":' + f(zTop) + ',"zoneBot":' + f(zBot) +
     ',"lvl4h":' + (na(l4) ? "null" : f(l4)) + ',"lvl15":' + (na(l15) ? "null" : f(l15)) + ',"lvl5":' + (na(l5) ? "null" : f(l5)) + ',"opp":' + (na(opp) ? "null" : f(opp)) +
     ',"sweep":' + b(swName != "") + ',"sweepName":"' + swName + '","sweepLvl":' + (na(swLvl) ? "null" : f(swLvl)) + '}'

if longSig and lRisk > 0
    alert(setupJson("long", close, lSL, lFresh, lRoom, lStopOk, lZoneTop, lZoneBot, hUpLvl, mUpLvl, lUpLvl, supAbove, lSwName, lSwLvl), alert.freq_once_per_bar_close)
if shortSig and sRisk > 0
    alert(setupJson("short", close, sSL, sFresh, sRoom, sStopOk, sZoneTop, sZoneBot, hDnLvl, mDnLvl, lDnLvl, demBelow, sSwName, sSwLvl), alert.freq_once_per_bar_close)
if sendBars and barstate.isconfirmed
    string bos = mtfBosUp ? "up" : mtfBosDn ? "down" : ""
    alert('{"secret":"' + secret + '","type":"bar","symbol":"' + syminfo.ticker + '","price":' + f(close) + ',"high":' + f(high) + ',"low":' + f(low) + ',"bos15":"' + bos + '"}', alert.freq_once_per_bar_close)

// ---------- Drawing
fm(float x) => str.tostring(x, format.mintick)

drawPlan(bool isLong, float entry, float sl, string grade) =>
    float risk = math.abs(entry - sl)
    float k = isLong ? 1.0 : -1.0
    float be = entry + k * beR * risk
    float tp = entry + k * tpR * risk
    int r = bar_index + 30
    line.new(bar_index, entry, r, entry, color = color.gray, width = 1, force_overlay = true)
    line.new(bar_index, sl, r, sl, color = color.red, width = 2, force_overlay = true)
    line.new(bar_index, be, r, be, color = color.orange, style = line.style_dashed, force_overlay = true)
    line.new(bar_index, tp, r, tp, color = color.green, width = 2, force_overlay = true)
    label.new(r, sl, "SL " + fm(sl), style = label.style_label_left, color = color.new(color.red, 60), textcolor = color.white, size = size.tiny, force_overlay = true)
    label.new(r, be, "at " + fm(be) + " → stop to BE (" + str.tostring(beR) + "R)", style = label.style_label_left, color = color.new(color.orange, 70), textcolor = color.white, size = size.tiny, force_overlay = true)
    label.new(r, tp, "TP " + fm(tp) + " (" + str.tostring(tpR) + "R) — full exit", style = label.style_label_left, color = color.new(color.green, 60), textcolor = color.white, size = size.tiny, force_overlay = true)
    label.new(bar_index, isLong ? low : high, (isLong ? "▲ ENTER LONG — " : "▼ ENTER SHORT — ") + grade + (grade == "A" ? " (no sweep)" : "") + "\nentry " + fm(entry) + " · SL " + fm(sl),
         style = isLong ? label.style_label_up : label.style_label_down, color = grade == "A" ? color.new(color.orange, 0) : isLong ? color.new(color.green, 0) : color.new(color.red, 0), textcolor = color.white, size = size.normal, force_overlay = true)

drawSweep(float lv, string nm, int fromBar) =>
    line.new(fromBar, lv, bar_index, lv, color = color.new(color.white, 30), style = line.style_dashed, force_overlay = true)
    label.new(fromBar, lv, "$$$ " + nm + " taken", style = label.style_label_right, color = color.new(color.white, 80), textcolor = color.white, size = size.tiny, force_overlay = true)

// A+ = liquidity taken (first or later visit) · A = first visit, no sweep · anything else is skipped (with the reason)
gradeOf(bool swept, bool fresh, bool stopOk, bool roomOk) =>
    string g = ""
    string why = ""
    if not stopOk
        why := "stop size not normal"
    else if not roomOk
        why := "no room to " + str.tostring(tpR) + "R"
    else if not inSess
        why := "outside the session"
    else if swept
        g := "A+"
    else if fresh
        g := "A"
    else
        why := "second visit without liquidity taken"
    [g, why]
[lGrade, lWhy] = gradeOf(lSwept, lFresh, lStopOk, lRoomOk)
[sGrade, sWhy] = gradeOf(sSwept, sFresh, sStopOk, sRoomOk)
bool lEnter = longSig and lRisk > 0 and lGrade != ""
bool sEnter = shortSig and sRisk > 0 and sGrade != "" and not lEnter
bool inFlat = not na(time(timeframe.period, flatSess, "America/New_York"))

if longSig and lSwept
    drawSweep(lSwLvl, lSwName, lBar)
if shortSig and sSwept
    drawSweep(sSwLvl, sSwName, sBar)
if lEnter
    drawPlan(true, close, lSL, lGrade)
else if longSig and lRisk > 0
    label.new(bar_index, low, "long trigger — skip: " + lWhy, style = label.style_label_up, color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny, force_overlay = true)
if sEnter
    drawPlan(false, close, sSL, sGrade)
else if shortSig and sRisk > 0
    label.new(bar_index, high, "short trigger — skip: " + sWhy, style = label.style_label_down, color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny, force_overlay = true)

// ---------- The A+ trade, followed candle by candle (tells you what to do while you're in it)
var int gDir = 0
var float gE = na
var float gSL = na
var float gRisk = na
var bool gBE = false
var int gBar = 0
var string gSw = ""
var string gGrade = ""
var string gEvent = ""
var int gEvBar = 0
if gDir != 0 and bar_index > gBar
    float tpLvl = gE + gDir * tpR * gRisk
    float stopNow = gBE ? gE + gDir * beOffR * gRisk : gSL
    bool hitStop = gDir == 1 ? low <= stopNow : high >= stopNow
    bool hitTp = gDir == 1 ? high >= tpLvl : low <= tpLvl
    if hitStop
        gEvBar := bar_index
        gEvent := gBE ? "Out at break-even — no loss. Done." : "Stopped out: -1R. That's the plan working. No revenge."
        label.new(bar_index, gDir == 1 ? low : high, gBE ? "BE stop — out flat" : "stopped −1R", style = gDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.small, force_overlay = true)
        gDir := 0
    else if hitTp
        gEvBar := bar_index
        gEvent := "Target hit: +" + str.tostring(tpR) + "R. Close it — done for this one."
        label.new(bar_index, gDir == 1 ? high : low, "🎯 TARGET " + str.tostring(tpR) + "R — CLOSE", style = gDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.normal, force_overlay = true)
        gDir := 0
    else if inFlat
        gEvBar := bar_index
        gEvent := "Close-out time — out of the trade. No holding into the session close."
        label.new(bar_index, gDir == 1 ? high : low, "close-out — OUT", style = gDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 0), textcolor = color.white, size = size.small, force_overlay = true)
        gDir := 0
    else if not gBE and (gDir == 1 ? high >= gE + beR * gRisk : low <= gE - beR * gRisk)
        gBE := true
        label.new(bar_index, gDir == 1 ? high : low, "🔒 +" + str.tostring(beR) + "R — MOVE STOP TO " + fm(gE + gDir * beOffR * gRisk), style = gDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.orange, 0), textcolor = color.white, size = size.normal, force_overlay = true)
if lEnter or sEnter
    gDir := lEnter ? 1 : -1
    gE := close
    gSL := lEnter ? lSL : sSL
    gRisk := math.abs(close - gSL)
    gBE := false
    gBar := bar_index
    gSw := lEnter ? lSwName : sSwName
    gGrade := lEnter ? lGrade : sGrade

// ---------- Backtest with the same rules
var float tEntry = na
var float tRisk = na
var int tDir = 0
var bool tBE = false
bool enterL = lEnter and (not aPlusOnly or lGrade == "A+") and strategy.position_size == 0
bool enterS = sEnter and (not aPlusOnly or sGrade == "A+") and strategy.position_size == 0 and not enterL

if strategy.position_size == 0 and not enterL and not enterS
    tDir := 0
if enterL
    float qty = strategy.equity * riskPct / 100 / (lRisk * syminfo.pointvalue)
    strategy.entry("L", strategy.long, qty = qty)
    tEntry := close
    tRisk := lRisk
    tDir := 1
    tBE := false
if enterS
    float qty = strategy.equity * riskPct / 100 / (sRisk * syminfo.pointvalue)
    strategy.entry("S", strategy.short, qty = qty)
    tEntry := close
    tRisk := sRisk
    tDir := -1
    tBE := false

if tDir != 0 and strategy.position_size != 0 and not tBE
    tBE := tDir == 1 ? high >= tEntry + beR * tRisk : low <= tEntry - beR * tRisk
if tDir == 1
    strategy.exit("LX", from_entry = "L", stop = tBE ? tEntry + beOffR * tRisk : tEntry - tRisk, limit = tEntry + tpR * tRisk)
if tDir == -1
    strategy.exit("SX", from_entry = "S", stop = tBE ? tEntry - beOffR * tRisk : tEntry + tRisk, limit = tEntry - tpR * tRisk)
if inFlat and strategy.position_size != 0
    strategy.close_all(comment = "close-out")

// ---------- Status panel
// Row 1 is the "EDGE code": Edge on your computer reads it off the screen (Coach → Chart reader).
var table panel = table.new(position.top_right, 2, 16, bgcolor = color.new(color.black, 15), border_width = 1, force_overlay = true)
if barstate.isfirst
    table.merge_cells(panel, 0, 0, 1, 0)
    table.merge_cells(panel, 0, 1, 1, 1)
ok(bool x) => x ? "✓" : "…"
// the zone closest to price, e.g. "4101.2 – 4112.5  visit 1"
nearestZoneText(array<Zone> list, bool isDem) =>
    string txt = "none"
    float bestD = na
    for z in list
        if z.valid
            float d = math.abs(isDem ? close - z.top : z.bot - close)
            if na(bestD) or d < bestD
                bestD := d
                txt := fm(z.bot) + " – " + fm(z.top) + (z.touches == 0 ? "  fresh" : "  visit " + str.tostring(z.touches))
    txt
if barstate.islast
    string code = "EDGE " + syminfo.ticker + " " + (gDir == 1 ? "LONG " + gGrade + " E " + fm(gE) + " SL " + fm(gSL) : gDir == -1 ? "SHORT " + gGrade + " E " + fm(gE) + " SL " + fm(gSL) : "WAIT") + " PX " + fm(close)
    table.cell(panel, 0, 0, code, text_color = color.white, bgcolor = color.black, text_size = size.large, text_font_family = font.family_monospace)

    // what to do right now
    float tpLvl = gE + gDir * tpR * gRisk
    float beLvl = gE + gDir * beR * gRisk
    string doNow = gDir != 0 ? (gBE ? "IN " + (gDir == 1 ? "LONG" : "SHORT") + ": stop at break-even " + fm(gE + gDir * beOffR * gRisk) + " · target " + fm(tpLvl) + " — hands off"
                                   : "IN " + (gDir == 1 ? "LONG" : "SHORT") + ": stop " + fm(gSL) + " · at " + fm(beLvl) + " move stop to BE · target " + fm(tpLvl))
         : gEvent != "" and bar_index - gEvBar <= 6 ? gEvent
         : not inSess ? "Session closed — no new trades"
         : lState == 2 ? (lSwept ? "Long: wait for a 5m candle to CLOSE above the last 5m high → ENTER (A+)" : lTouch == 1 ? "Long: no sweep yet — a 5m close above the last 5m high is an A entry (A+ needs the sweep)" : "Long: second visit — no entry until liquidity is swept")
         : sState == 2 ? (sSwept ? "Short: wait for a 5m candle to CLOSE below the last 5m low → ENTER (A+)" : sTouch == 1 ? "Short: no sweep yet — a 5m close below the last 5m low is an A entry (A+ needs the sweep)" : "Short: second visit — no entry until liquidity is swept")
         : lState == 1 ? "Long: in the demand zone — wait for a 15m break of structure up"
         : sState == 1 ? "Short: in the supply zone — wait for a 15m break of structure down"
         : "Wait — price isn't at a 4H zone. Nothing to do."
    color doCol = gDir != 0 ? (gBE ? color.lime : color.orange) : lState == 2 or sState == 2 ? color.yellow : color.silver
    table.cell(panel, 0, 1, doNow, text_color = doCol, text_size = size.normal)

    // the steps, in order (for the setup that's forming, or the 4H trend's side when nothing is)
    // in an A+ trade every step was done (the setup itself resets on the entry candle)
    bool inT = gDir != 0
    bool isL = inT ? gDir == 1 : lState > 0 or (sState == 0 and hTrend == 1)
    int stt = isL ? lState : sState
    table.cell(panel, 0, 2, isL ? "LONG steps" : inT or hTrend == -1 or sState > 0 ? "SHORT steps" : "Steps", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 2, "", text_size = size.small)
    table.cell(panel, 0, 3, ok(inT or (isL ? hTrend == 1 : hTrend == -1)) + " 1  4H trend", text_color = c4h, text_size = size.small)
    table.cell(panel, 1, 3, hTrend == 1 ? "UP" : hTrend == -1 ? "DOWN" : "none yet", text_color = hTrend == 1 ? color.lime : hTrend == -1 ? color.red : color.silver, text_size = size.small)
    int vis = isL ? lTouch : sTouch
    table.cell(panel, 0, 4, ok(inT or stt > 0) + " 2  4H zone touched", text_color = c4h, text_size = size.small)
    table.cell(panel, 1, 4, inT ? "done" : stt > 0 ? (vis == 1 ? "first visit" : "visit " + str.tostring(vis) + " — needs a sweep") : "waiting", text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 5, ok(inT ? gGrade == "A+" : stt > 0 and (isL ? lSwept : sSwept)) + " 3  liquidity taken (A+)", text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 5, inT ? (gGrade == "A+" ? gSw : "no sweep — A setup") : stt > 0 and (isL ? lSwept : sSwept) ? (isL ? lSwName : sSwName) : "waiting", text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 6, ok(inT or stt == 2) + " 4  15m break of structure", text_color = c15, text_size = size.small)
    table.cell(panel, 1, 6, inT or stt == 2 ? "done" : "waiting", text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 7, ok(gDir != 0) + " 5  5m candle close → ENTER", text_color = c5, text_size = size.small)
    table.cell(panel, 1, 7, gDir != 0 ? "entered " + fm(gE) : "waiting", text_color = color.white, text_size = size.small)

    table.cell(panel, 0, 8, "Demand", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 8, nearestZoneText(dems, true), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 9, "Supply", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 9, nearestZoneText(sups, false), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 10, "Session", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 10, inSess ? "open" : "closed — no trades", text_color = inSess ? color.lime : color.gray, text_size = size.small)
    table.cell(panel, 0, 11, "Exits", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 11, "BE at " + str.tostring(beR) + "R · TP " + str.tostring(tpR) + "R", text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 12, "■ 4H", text_color = c4h, text_size = size.small)
    table.cell(panel, 1, 12, "zones + trend break", text_color = c4h, text_size = size.small)
    table.cell(panel, 0, 13, "■ 15m", text_color = c15, text_size = size.small)
    table.cell(panel, 1, 13, "confirmation break", text_color = c15, text_size = size.small)
    table.cell(panel, 0, 14, "■ 5m", text_color = c5, text_size = size.small)
    table.cell(panel, 1, 14, "entry break", text_color = c5, text_size = size.small)
    if timeframe.period != "5"
        table.cell(panel, 0, 1, "Use a 5-minute chart — the steps are built for it", text_color = color.orange, text_size = size.normal)
